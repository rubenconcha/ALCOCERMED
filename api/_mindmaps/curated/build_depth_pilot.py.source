"""Two authored pilot maps, preserving protected delivery and source provenance."""
from pathlib import Path
import json
ROOT=Path(__file__).resolve().parents[3]

def node(title,text,page,chapter):
    return {'title':title,'text':text,'source':{'book':'Saladin: Anatomía y fisiología','chapter':chapter,'pdfPage':page,'kind':'original_synthesis'}}

def section(title,rows,chapter):
    return {'title':title,'groups':[{'title':'Comprender y relacionar','items':[node(*row,chapter) for row in rows]}]}

BLOOD=[
 ('Cinco células: reconocer y comparar',[
  ('Neutrófilos: 60-70 %','En el cuadro 18.6 del Saladin suministrado son el tipo más abundante. Su núcleo maduro suele presentar 3-5 lóbulos, con gránulos finos en el citoplasma. La segmentación nuclear no significa que existan varios núcleos. Fagocitan bacterias y emplean sustancias antimicrobianas; su aspecto y su función deben estudiarse juntos.',726),
  ('Linfocitos: 25-33 %','Los pequeños presentan un núcleo redondo que ocupa casi toda la célula y un borde estrecho de citoplasma. La categoría incluye B, T y NK, con funciones distintas: producción de anticuerpos mediante células plasmáticas derivadas de B, regulación o citotoxicidad por subpoblaciones T y defensa citotóxica innata por NK. Un frotis habitual no distingue por sí solo todas esas funciones.',727),
  ('Monocitos: 3-8 %','Son células grandes, con citoplasma relativamente abundante y núcleo arriñonado o en herradura. Pueden pasar a los tejidos y diferenciarse en macrófagos, participar en la fagocitosis y presentar antígenos. No son neutrófilos envejecidos ni se identifican únicamente por su tamaño: hay que integrar tamaño, núcleo y citoplasma.',727),
  ('Eosinófilos: 2-4 %','El núcleo suele ser bilobulado y los gránulos específicos grandes adquieren tonos anaranjados o rosados. Sus mecanismos incluyen liberación de sustancias que dañan parásitos y participación en respuestas inflamatorias y alérgicas. La asociación con alergia o parasitosis orienta, pero una cifra aislada no permite identificar una enfermedad concreta.',726),
  ('Basófilos: menos de 0,5 %','Son los menos numerosos en el cuadro del libro. Sus gránulos violeta oscuros pueden ocultar parcialmente el núcleo. Liberan mediadores como histamina y heparina. No deben confundirse con plaquetas, con eosinófilos ni asumirse como equivalentes a todos los mastocitos de los tejidos.',726)]),
 ('De la circulación al foco de defensa',[
  ('La sangre es una vía de tránsito','Muchos leucocitos no ejercen toda su función defensiva dentro del vaso. Circulan, reciben señales y pasan a los tejidos donde se encuentra la lesión. Por eso el recuento de sangre periférica es una ventana parcial de un proceso dinámico; no representa el número total de células inmunitarias del organismo.',724),
  ('Diapédesis y quimiotaxis no son sinónimos','La diapédesis es el paso del leucocito a través de la pared vascular. La quimiotaxis es su desplazamiento orientado por señales químicas. Una describe cruzar una barrera y la otra, seguir una dirección; ambas pueden formar parte del reclutamiento hacia un foco inflamatorio.',725),
  ('Fagocitosis: capturar, incorporar y destruir','Neutrófilos y macrófagos reconocen blancos, los incorporan y los degradan mediante mecanismos intracelulares. La liberación de mediadores también modifica el entorno y atrae otras células. El material de una respuesta inflamatoria incluye células activas, microorganismos y restos; no equivale exclusivamente a bacterias vivas.',725),
  ('Presentar antígenos conecta respuestas','Un macrófago puede procesar material y exponer fragmentos antigénicos a otras células inmunitarias. La eliminación del blanco y la comunicación con linfocitos son funciones relacionadas, pero diferentes. Esta conexión explica por qué clasificar células solo como fagocitarias deja incompleta su contribución a la defensa.',727)]),
 ('Porcentaje frente a recuento absoluto',[
  ('Qué mide el diferencial','El porcentaje expresa qué fracción de los leucocitos contados pertenece a un tipo. No expresa cuántas células de ese tipo hay por unidad de volumen. Un cambio relativo puede depender de la subida o la bajada de otras poblaciones; se interpreta junto al recuento total y, cuando está disponible, al absoluto informado.',729),
  ('Cómo calcular el absoluto','Multiplica los leucocitos totales por la fracción decimal del tipo celular. Si hay 8.000 leucocitos/µL y 65 % de neutrófilos, el cálculo es 8.000 × 0,65 = 5.200 neutrófilos/µL. No se multiplica por 65 sin dividir entre 100. La unidad final sigue siendo células por microlitro.',729),
  ('El mismo porcentaje no es la misma cantidad','Con 50 % de neutrófilos, un total de 4.000/µL corresponde a 2.000 neutrófilos/µL; un total de 12.000/µL corresponde a 6.000/µL. Los porcentajes son iguales y los absolutos son diferentes. El ejemplo demuestra una relación aritmética; no asigna por sí mismo normalidad o enfermedad.',729),
  ('Un aumento relativo puede engañar','Si los linfocitos aumentan como proporción porque descienden otras poblaciones, el porcentaje linfocitario puede subir sin que su recuento absoluto haya aumentado. Antes de concluir proliferación de una población, revisa el total, el absoluto y el contexto del hemograma.',729),
  ('Qué significan los rangos del libro','Los porcentajes 60-70, 25-33, 3-8, 2-4 y menos de 0,5 corresponden al cuadro de esta edición. Son intervalos didácticos de poblaciones diferentes: no se suman todos sus mínimos o máximos para construir un individuo. Los intervalos de un laboratorio dependen además de su método y de la población de referencia.',726)]),
 ('Cambios: asociaciones y límites',[
  ('Neutrofilia: una pista, no una etiqueta','El libro relaciona cifras elevadas de neutrófilos con infecciones bacterianas. Para interpretar un caso se añaden síntomas, evolución y otros datos; una elevación aislada no demuestra por sí sola una etiología bacteriana ni indica automáticamente un tratamiento. Asociación no equivale a diagnóstico confirmado.',729),
  ('Eosinofilia: pensar en más de una causa','Alergia y parasitosis forman parte de las asociaciones destacadas en el texto. Compararlas obliga a valorar exposición, manifestaciones y otros hallazgos. La pregunta útil no es solamente qué célula subió, sino si el patrón completo respalda la explicación propuesta.',726),
  ('Linfocitos y monocitos: funciones distintas','Los linfocitos participan en respuestas inmunitarias de distintos tipos; los monocitos también se relacionan con inflamación y actividad fagocitaria en tejidos. Un aumento de una población no transforma a todas sus células en funcionalmente idénticas ni permite determinar el agente causal con un solo número.',727),
  ('Leucopenia no es anemia','Leucopenia describe una disminución de leucocitos; anemia se refiere a una reducción de la capacidad de transporte de oxígeno vinculada a los eritrocitos o la hemoglobina. Ambas pueden coexistir, pero son variables diferentes. Para evitar confundirlas, identifica primero qué línea celular mide el dato.',729),
  ('Muchos leucocitos no siempre implican buena defensa','En las leucemias puede haber proliferación de células anormales y desplazamiento de la hematopoyesis normal. Un recuento alto no garantiza células maduras o competentes. Por eso deben distinguirse cantidad, maduración y función; el libro también relaciona el reemplazo medular con anemia y alteraciones plaquetarias.',730)]),
 ('Aplicar con casos razonados',[
  ('Caso 1: 10.000/µL y 3 % de eosinófilos','El absoluto calculado es 300 eosinófilos/µL: 10.000 × 0,03. El 3 % cae dentro del intervalo didáctico de Saladin para esa población. Eso no demuestra ni descarta por sí solo alergia o parasitosis: el caso solo permite calcular e identificar el alcance limitado del dato.',726),
  ('Caso 2: dos hemogramas con 30 % de linfocitos','Si el primer total es 5.000/µL y el segundo 15.000/µL, los absolutos son 1.500 y 4.500 linfocitos/µL. Concluir que las cantidades son iguales porque ambos informan 30 % ignora el denominador. Esta comparación evalúa comprensión del diferencial, no memorización de una enfermedad.',729),
  ('Caso 3: gránulos naranjas y núcleo de dos lóbulos','La combinación apoya identificar un eosinófilo. Un neutrófilo suele mostrar segmentación diferente y gránulos más finos; un basófilo presenta gránulos oscuros. La explicación debe justificar el rasgo positivo y por qué los distractores se ajustan peor, en lugar de responder solo con el nombre.',726),
  ('Caso 4: infección e insuficiencia medular','Encontrar infección junto a un recuento leucocitario bajo obliga a recordar que la capacidad de respuesta depende de producción y función, no solo de que exista un estímulo infeccioso. El ejemplo impide aplicar la regla errónea de que toda infección necesariamente eleva los leucocitos.',729)]),
 ('Integrar y evitar errores frecuentes',[
  ('Granulocitos frente a agranulocitos','Neutrófilos, eosinófilos y basófilos se agrupan por sus gránulos específicos visibles. Linfocitos y monocitos se llaman agranulocitos por la ausencia de gránulos específicos notorios en la tinción habitual, no porque carezcan de todos los orgánulos o lisosomas. La clasificación es morfológica y no sustituye el análisis funcional.',724),
  ('Diferencial no es hematócrito','El diferencial compara tipos de leucocitos. El hematócrito expresa la fracción del volumen sanguíneo ocupada por eritrocitos. Usar el 65 % de neutrófilos como si fuera hematócrito mezcla denominadores distintos y genera una interpretación incorrecta antes de cualquier razonamiento clínico.',714),
  ('Secuencia para explicar un resultado','Primero identifica el tipo celular y su unidad; después diferencia porcentaje de absoluto; compara con la referencia pertinente e integra morfología, función y contexto. Finalmente formula una interpretación proporcionada a la evidencia. Si la información no basta, la respuesta correcta reconoce qué dato falta en lugar de inventar un diagnóstico.',729)])]

SENSES=[
 ('La retina transforma y procesa',[
  ('Tres niveles de la señal visual','Fotorreceptores, células bipolares y células ganglionares forman una secuencia principal de transmisión. También intervienen circuitos laterales y vías con células amacrinas. La retina no actúa como una película que solo registra luz: modifica y organiza información antes de enviarla por el nervio óptico.',648),
  ('Luz y señal viajan en sentidos diferentes','En la retina humana, la luz atraviesa capas internas antes de alcanzar los segmentos externos de los fotorreceptores cercanos al epitelio pigmentario. La información neural sigue la secuencia hacia bipolares y ganglionares. Una flecha de un esquema debe especificar cuál de esos recorridos representa.',647),
  ('Segmento externo y terminal sináptica','El segmento externo contiene el sistema de membranas y fotopigmentos que capta luz. La terminal sináptica comunica cambios a las neuronas siguientes mediante liberación de neurotransmisor. Detectar el estímulo y transmitirlo son procesos conectados, pero ocurren en regiones funcionales distintas de la célula.',649)]),
 ('Comparar oscuridad y luz',[
  ('En oscuridad el fotorreceptor no está apagado','Los fotorreceptores liberan glutamato de manera tónica en oscuridad. La disponibilidad de GMPc favorece canales catiónicos abiertos y una corriente de entrada que mantiene una despolarización relativa. Decir que la oscuridad elimina toda actividad confunde ausencia de luz con ausencia de señalización celular.',650),
  ('La luz reduce la entrada de cationes','La activación del fotopigmento desencadena una cascada que reduce el GMPc. Se cierran canales dependientes de este mensajero y disminuye la corriente de entrada. El potencial se hace más negativo: el fotorreceptor se hiperpolariza y reduce su liberación de glutamato.',650),
  ('Potencial graduado no es potencial de acción','La respuesta del fotorreceptor cambia de manera graduada; no consiste en disparar más potenciales de acción por recibir más luz. En la vía de salida, las células ganglionares generan potenciales de acción. Separar ambos niveles evita atribuir la respuesta del nervio óptico a la membrana del bastón.',651),
  ('Menos glutamato puede significar más respuesta ON','El efecto del glutamato depende del circuito bipolar. En vías ON, la reducción de glutamato asociada a la iluminación permite una respuesta de signo inverso a la del fotorreceptor; las vías OFF se comportan de modo diferente. Por ello no todas las bipolares responden igual ni se debe trasladar una regla única a toda la retina.',650)]),
 ('Seguir la cascada y el pigmento',[
  ('Del fotón al cambio del pigmento','En la rodopsina, la absorción de luz modifica el retinal desde su configuración cis hacia la trans y activa el sistema de la opsina. El fotón no abre directamente un canal del nervio óptico: el cambio molecular inicia una secuencia intracelular que modifica la corriente del fotorreceptor.',649),
  ('Amplificación mediante una cascada','El esquema molecular ampliado se resume como fotopigmento, transducina, fosfodiesterasa y reducción de GMPc. Una secuencia enzimática conecta la absorción de luz con el cierre de canales. Saladin representa la cascada de forma resumida; la terminología molecular adicional corresponde a la ampliación fisiológica, no a una cita literal del libro.',649),
  ('El pigmento necesita regenerarse','Para mantener la respuesta, el retinal debe volver a una configuración funcional y reunirse con la opsina. La regeneración y el blanqueado ocurren con velocidades relativas que cambian según la iluminación. Estudiar solo la primera absorción del fotón deja sin explicar cómo un receptor puede seguir participando en la visión.',650),
  ('No confundir reciclaje del pigmento y señal eléctrica','La regeneración permite recuperar pigmento funcional; la hiperpolarización describe un cambio de potencial de membrana. Son fenómenos ligados al ciclo visual, pero no equivalentes. El primero no es un potencial de acción y el segundo no significa que la célula haya destruido permanentemente toda su rodopsina.',650)]),
 ('Bastones, conos y resolución',[
  ('Bastones: sensibilidad con menor detalle','Los bastones permiten visión con poca luz y no proporcionan la discriminación cromática de los conos. La convergencia de señales mejora la detección de estímulos débiles, pero reduce la precisión para separar puntos cercanos. La alta sensibilidad y la alta resolución son propiedades diferentes.',651),
  ('Conos y fóvea: detalle y color','Los conos participan en visión diurna y cromática. La región foveal favorece la agudeza visual por su organización y menor convergencia en sus circuitos. No basta afirmar que los conos ven colores: hay que relacionar tipo de receptor, localización y circuito con la tarea visual.',652),
  ('Tres clases de conos en esta edición','Saladin presenta máximos de sensibilidad de 420 nm para S, 531 nm para M y 558 nm para L. Son los valores que se conservan al estudiar este libro. No se interpreta cada cono como un detector exclusivo de un único color: las sensibilidades se superponen y el sistema compara patrones de actividad.',652),
  ('El nervio óptico transporta una señal ya procesada','Los axones de las células ganglionares forman el nervio óptico. La divergencia entre el número de receptores y el de fibras de salida obliga a integrar señales en la retina. El nervio no contiene un axón independiente de cada bastón y de cada cono.',648)]),
 ('Adaptación: explicar el cambio de ambiente',[
  ('De un ambiente oscuro a uno iluminado','Al aumentar bruscamente la iluminación, la respuesta inicial cambia mientras la retina ajusta su sensibilidad y se modifica el equilibrio de los pigmentos. La constricción pupilar reduce entrada de luz, pero no explica por sí sola toda la adaptación retiniana. Hay mecanismos ópticos y celulares que deben distinguirse.',651),
  ('De la luz a la oscuridad','La visión escotópica mejora progresivamente cuando la regeneración de rodopsina supera su blanqueado. La dilatación pupilar ayuda, pero recuperar pigmento y reajustar la sensibilidad lleva tiempo. El libro describe una mejoría temprana seguida de un período mayor hasta alcanzar máxima sensibilidad en condiciones de oscuridad.',651),
  ('Vitamina A: relacionar estructura y función','El retinal es un derivado de vitamina A y forma parte de los pigmentos visuales. Esta relación permite conectar nutrición con el funcionamiento de los fotorreceptores. La dificultad para ver en poca luz no identifica por sí sola una carencia: puede tener otras causas y necesita información adicional.',649)]),
 ('Aplicar sin memorizar frases sueltas',[
  ('Caso 1: llega luz a un bastón','La respuesta esperada es disminución de GMPc, cierre de canales catiónicos, hiperpolarización y menor liberación de glutamato. La alternativa de abrir más canales y despolarizar invierte la secuencia. La de producir potenciales de acción en el bastón confunde el receptor con la salida ganglionar.',650),
  ('Caso 2: disminuye el glutamato y responde una bipolar','No hay contradicción si pertenece a una vía ON. El signo de la sinapsis determina cómo la neurona siguiente interpreta la reducción del neurotransmisor. Para contestar, explica el circuito y evita afirmar que cualquier reducción de glutamato reduce necesariamente toda actividad visual.',650),
  ('Caso 3: detalle fino con iluminación intensa','Los conos y la organización foveal son más adecuados para esta tarea que el sistema de bastones. La justificación incluye menor convergencia y mayor resolución; no basta responder que los conos son más sensibles, porque la mayor sensibilidad a estímulos débiles corresponde al sistema escotópico.',652),
  ('Caso 4: un dibujo confunde sus flechas','Si una flecha une fotorreceptor, bipolar y ganglionar, debe rotularse como flujo de información neural. Presentarla como dirección de entrada de luz en la retina humana invierte el recorrido anatómico. Un esquema correcto distingue posición de las células, llegada del estímulo y salida de la señal.',647)])]

def main():
    dest=ROOT/'api/_mindmaps'; curated=[]
    for ident,title,parent,topic,chapter,rows,illustration in [
      ('morfo_18_sangre__07','Diferencial leucocitario: proporciones e interpretación','morfo_18_sangre.png','La sangre',18,BLOOD,'/assets/mindmaps/illustrations/morfo_18_sangre.webp'),
      ('morfo_16_organos_sentidos__07','Retina y fototransducción: mecanismos paso a paso','morfo_16_organos_sentidos.png','Órganos de los sentidos',16,SENSES,'/assets/mindmaps/illustrations/morfo_16_organos_sentidos.webp')]:
      sections=[section(*r,chapter) for r in rows]
      data={'id':ident,'title':title,'topic':topic,'sections':sections,
       'assets':{'image':illustration,'alt':'Ilustración de apoyo de '+topic,'download':'/api/mindmap?id='+ident+'&format=image','filename':ident+'-Ben-Carson.webp','source':{'book':'Saladin: Anatomía y fisiología','chapter':chapter,'kind':'original_synthesis'},'generative_download':True},
       'review':{'state':'automated_review_passed','clinical_diagnosis_tool':False,'doctor_approved':False,'scope':'Primer lote de ampliación; no supone aprobación del capítulo completo.'}}
      if chapter==16:data['supplementary_reference']={'title':'Phototransduction in Rods and Cones, Webvision','url':'https://www.ncbi.nlm.nih.gov/books/NBK52768/','scope':'Nomenclatura molecular complementaria; el esquema del Saladin entregado es más resumido.'}
      (dest/(ident+'.json')).write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
      curated.append({'id':ident,'titulo':title,'root_title':title,'materia':'Morfofunción','tema':topic,'parent_key':parent,'url_imagen':'premium/'+ident+'.json','descripcion':'Ampliación con mecanismos, comparación y casos razonados. Incluye lámina ilustrada descargable.','premium':True,'acceso_gratis':False,'preview':'/assets/mindmaps/premium-previews/'+ident+'.webp','curated':True})
    (ROOT/'content/mindmaps-curated-additions.json').write_text(json.dumps(curated,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
    catalog=json.loads((ROOT/'content/mindmaps-premium-catalog.json').read_text(encoding='utf8'))
    catalog=[r for r in catalog if r['id'] not in {m['id'] for m in curated}]+curated
    (ROOT/'content/mindmaps-premium-catalog.json').write_text(json.dumps(catalog,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
    (ROOT/'mindmap-premium-catalog.js').write_text('/* Public metadata only. Full explanations and downloads require verified access. */\nwindow.MINDMAP_PREMIUM_CATALOG = '+json.dumps(catalog,ensure_ascii=False,separators=(',',':'))+';\n',encoding='utf8')
    print(json.dumps({'new_maps':len(curated),'authored_concepts':sum(len(s[1]) for s in BLOOD+SENSES),'catalog_maps':len(catalog)}))

if __name__=='__main__':main()
