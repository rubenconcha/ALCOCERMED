"""Original syntheses of the supplied Saladin ch.16, in the approved native viewer.
Do not run the generic paragraph matcher over these reviewed entries.
"""
import json, hashlib
from pathlib import Path

ROOT=Path(__file__).resolve().parents[3]
BOOK=Path('C:/Users/PC/Downloads/morfofisiliologia-saladin-anatomia-y-fisiologia (1) (3).pdf')
COLORS=['#429243','#267dd0','#8c59b0','#e58929','#209caa','#d76387']
def leaf(title,text,page):
 return {'title':title,'text':text,'source':{'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPage':page,'kind':'original_synthesis'}}
def branch(title,*items):return {'title':title,'groups':[{'title':title,'items':list(items)}]}

MAPS={
'01':('Sentidos generales y receptores',[
 branch('Panorama y función',
  leaf('Generales: receptores distribuidos','Tacto, presión, estiramiento, temperatura y dolor se detectan en piel, músculos, tendones, articulaciones y vísceras. Su distribución extensa los distingue de los sentidos especiales. La información puede producir una sensación consciente o participar en reflejos y regulación interna sin llamar nuestra atención.',613),
  leaf('Especiales: órganos y partes','Visión: ojo y retina. Audición: oído externo, medio e interno, con receptores en la cóclea. Equilibrio: utrículo, sáculo y conductos semicirculares. Gusto: botones gustativos, principalmente linguales. Olfato: mucosa olfativa del techo nasal. Son modalidades distintas, con órganos especializados e inervación por pares craneales.',613),
  leaf('Por qué importan los receptores','Un receptor detecta una condición física o química y convierte la energía del estímulo en una señal eléctrica. El sistema nervioso utiliza esas señales para localizar cambios, reconocer el entorno y regular respuestas. Un órgano sensitivo incluye además tejidos accesorios que favorecen la detección; receptor y órgano no son sinónimos.',611)),
 branch('Sin cápsula: tacto y temperatura',
  leaf('Libres: piel y mucosas','Son terminaciones sensitivas sin una cubierta conjuntiva especializada. Son abundantes en piel y mucosas y participan en dolor, calor y frío. La modalidad depende de la especialización de la terminación, no de que toda terminación libre detecte obligatoriamente los tres estímulos a la vez.',614),
  leaf('Merkel: epidermis basal','El disco táctil es una terminación aplanada asociada a una célula de Merkel en el estrato basal de la epidermis. Responde al contacto ligero y contribuye a reconocer bordes, formas y textura. Su adaptación lenta permite mantener información mientras continúa el contacto: es un receptor tónico.',614),
  leaf('Pilosos: alrededor del folículo','Las dendritas rodean la base del folículo y responden cuando un contacto dobla el pelo. La adaptación rápida destaca el movimiento nuevo y reduce la señal durante una deformación sostenida. No son corpúsculos de Meissner: en este caso el desplazamiento del propio pelo transmite el estímulo a la terminación.',614)),
 branch('Con cápsula: ubicación y función',
  leaf('Meissner: papilas dérmicas','Los corpúsculos táctiles se concentran en piel muy sensible sin pelo, como dedos y palmas. Su ubicación superficial y adaptación fásica favorecen detectar contactos ligeros y cambios de textura. No deben confundirse con los discos de Merkel, que se asocian a la capa basal epidérmica y responden de forma más sostenida.',615),
  leaf('Krause: mucosas','Los bulbos terminales son terminaciones rodeadas por tejido conjuntivo. El libro los sitúa en mucosas como labios y lengua, y en la conjuntiva, con funciones similares a los corpúsculos táctiles. Aquí se clasifican por la descripción del texto: no se les atribuye automáticamente la función exclusiva de receptor de frío.',615),
  leaf('Pacini: dermis profunda y otros tejidos','Los corpúsculos laminares poseen una terminación central rodeada por capas concéntricas. El texto los describe como fásicos, relacionados con presión profunda, vibración y estiramiento. Se encuentran en dermis profunda, cápsulas articulares, periostio y algunas vísceras. Su localización contrasta con los receptores cutáneos más superficiales.',615),
  leaf('Ruffini: dermis y cápsulas articulares','Los corpúsculos bulbosos son cápsulas alargadas presentes en dermis, tejido subcutáneo y cápsulas articulares. Detectan contacto o presión mantenidos, estiramiento cutáneo y movimiento articular. Su carácter tónico ayuda a conservar información sobre una deformación que persiste, en vez de señalar solamente el cambio inicial.',615)),
 branch('Propiocepción y clasificación',
  leaf('Husos musculares y órganos tendinosos','Los husos se localizan en músculos estriados y detectan su estiramiento. Los órganos tendinosos se encuentran en tendones e informan de la tensión ejercida sobre ellos. Ambos aportan información cinestésica: distinguir su ubicación evita confundir longitud muscular con tensión tendinosa como si fueran la misma variable.',615),
  leaf('Por modalidad del estímulo','Termorreceptores: temperatura; mecanorreceptores: deformación, presión, contacto o vibración; quimiorreceptores: composición química; fotorreceptores: luz; nociceptores: estímulos nocivos. Esta clasificación no sustituye la anatómica. Un receptor puede ser a la vez mecanorreceptor, encapsulado y propioceptor, porque cada palabra describe un criterio diferente.',613),
  leaf('Por origen del estímulo','Los exterorreceptores informan del entorno externo; los interorreceptores, de condiciones viscerales; los propioceptores, de posición y movimiento corporal. Piel, víscera y tendón ayudan a identificar el origen, pero deben relacionarse con la función concreta. No todos los estímulos internos llegan a convertirse en una sensación consciente.',613)),
 branch('Transducción y código sensitivo',
  leaf('Del estímulo al potencial de receptor','El estímulo genera un cambio eléctrico local. Si la célula receptora es una neurona y alcanza la condición necesaria, origina potenciales de acción en su vía aferente. En gusto y audición la célula receptora es epitelial: modifica su liberación de neurotransmisor y activa una neurona sensitiva adyacente.',611),
  leaf('Modalidad y ubicación','La modalidad se reconoce por la vía activada y su origen, no porque cada sentido tenga potenciales de acción de distinta forma. La ubicación depende de qué receptores y campos receptivos se activan. Campos pequeños y una mayor densidad de aferentes permiten discriminar contactos próximos con más precisión.',612),
  leaf('Intensidad y duración','La intensidad se representa mediante cambios en frecuencia de descarga y en el conjunto de fibras reclutadas. La duración se relaciona con el patrón de actividad a lo largo del tiempo. Una señal más intensa no equivale a que cada potencial de acción individual tenga una amplitud arbitrariamente mayor.',612)),
 branch('Adaptación y llegada al SNC',
  leaf('Fásicos frente a tónicos','Los fásicos responden con fuerza al cambio inicial y se adaptan con rapidez, como los receptores pilosos. Los tónicos mantienen la información durante más tiempo, como los discos de Merkel y muchos propioceptores. Adaptación significa cambio de respuesta ante un estímulo sostenido; no significa que el estímulo haya desaparecido.',613),
  leaf('Ruta consciente: receptor a corteza','La mayoría de las vías somatosensitivas se organiza en neuronas de primer, segundo y tercer orden. La información alcanza relevos en médula o tronco encefálico, luego el tálamo y finalmente la corteza somatosensitiva. Los puntos de cruce varían entre vías: no se debe dibujar toda modalidad cruzando en un único lugar.',615),
  leaf('Cabeza, cuerpo y cerebelo','En la cabeza participa sobre todo el trigémino para la sensibilidad somática; desde el cuerpo entran aferentes en la médula espinal. Las señales destinadas a percepción consciente y las cinestésicas hacia el cerebelo tienen destinos diferentes. Por ello, recibir información sensitiva no implica necesariamente hacerse consciente de ella.',616),
  leaf('Comprueba la relación estructura-función','Si un contacto dobla un pelo, relaciona el estímulo con el receptor piloso y su adaptación rápida. Si se mantiene presión sobre un borde, compara la respuesta tónica de Merkel. Para justificar la diferencia debes mencionar dónde se encuentra la terminación, cómo recibe la deformación y qué aspecto temporal de la señal conserva.',614))]),
'03':('Gusto: de la lengua al encéfalo',[
 branch('Anatomía de lengua y papilas',
  leaf('Papila, botón y célula: tres niveles','Una papila es un relieve de la superficie lingual; un botón es una agrupación microscópica de células; la célula gustativa es uno de sus componentes receptores. El libro estima casi 4 000 botones, sobre todo linguales, pero también en otras superficies orales y faríngeas. Esta cifra no es un recuento de papilas.',619),
  leaf('Filiformes: textura, sin botones','Son pequeñas, puntiagudas y las más abundantes en la lengua humana. No contienen botones gustativos, por lo que no se les asigna un sabor. Participan en la percepción de textura; la sensibilidad somática de la lengua debe diferenciarse de la modalidad gustativa, aunque ambas contribuyan a la experiencia al comer.',619),
  leaf('Fungiformes y foliadas','Las fungiformes tienen forma de hongo, se distribuyen ampliamente y se concentran en punta y bordes; el texto describe cerca de tres botones por papila. Las foliadas forman crestas laterales próximas a la zona de masticación. Son formas anatómicas de organización de los botones, no regiones exclusivas para un único sabor.',619),
  leaf('Valadas: siete a doce en V','Las papilas grandes posteriores forman una V y están rodeadas por surcos. Cada una contiene numerosos botones en las paredes orientadas hacia la ranura; el libro aproxima 250 por papila y hasta la mitad del conjunto de botones en este grupo. Pocas papilas pueden contener muchos botones: son cantidades distintas.',619)),
 branch('Botón gustativo y renovación',
  leaf('Poro y superficie receptora','Las sustancias disueltas alcanzan el poro gustativo y contactan las microvellosidades apicales de las células gustativas, denominadas cilios gustativos en el texto. El botón comprende aproximadamente 50 a 150 células gustativas, de soporte y basales. No se debe confundir este número celular con el de botones en una papila.',619),
  leaf('Célula gustativa: epitelio que comunica','La célula gustativa no es la neurona aferente. Detecta la sustancia y modifica la liberación de neurotransmisor en su región basal, donde contacta fibras sensitivas. Separar receptor epitelial y neurona permite seguir correctamente la secuencia: molécula, respuesta de la célula, señal química y actividad en la vía nerviosa.',619),
  leaf('Soporte y reemplazo celular','Las células de soporte sostienen el conjunto y las basales permiten renovar células gustativas. El texto describe una vida aproximada de siete a diez días para estas últimas. La renovación mantiene la población receptora a pesar de su recambio; no significa que cada sabor aparezca en una célula basal diferente.',619)),
 branch('Cinco sabores y experiencia',
  leaf('Salado y ácido','El sabor salado se relaciona con iones como sodio y potasio; el ácido, con hidrogeniones. Para activar el botón, las sustancias deben estar disueltas y alcanzar la superficie receptora. La saliva facilita ese acceso: ver un cristal de sal sobre una lengua seca no equivale a que ya haya estimulado eficazmente todos sus receptores.',619),
  leaf('Dulce, amargo y umami','El dulce se relaciona con diversos compuestos orgánicos, especialmente azúcares. El amargo se vincula, entre otros, con alcaloides; el umami, con aminoácidos como glutamato. Estos son cinco sabores primarios junto a salado y ácido, pero la experiencia de un alimento incluye más información que una simple lista de cinco categorías.',620),
  leaf('Sensibilidad regional, no exclusividad','El libro describe diferencias regionales de sensibilidad, pero también señala que los sabores primarios pueden detectarse a lo largo de la lengua. No se dibuja una lengua partida en zonas exclusivas de dulce, salado, ácido o amargo. Tener mayor sensibilidad a una categoría no implica incapacidad absoluta para detectar las demás.',621),
  leaf('Gusto no es todo el sabor de un alimento','Olor, temperatura y textura participan en la impresión global. La sensibilidad a sustancias irritantes puede involucrar terminaciones del trigémino en vez de botones gustativos. Por ello, detectar el picante o reconocer la textura no demuestra que exista una sexta zona gustativa ni que todo lo percibido al comer sea gusto.',621)),
 branch('Transducción: estímulo a aferente',
  leaf('Primer paso: disolver y contactar','La molécula debe disolverse en saliva y pasar al poro para alcanzar la membrana apical de la célula gustativa. Ese acceso precede a cualquier cambio eléctrico. La papila organiza el tejido, pero no sustituye el contacto molecular con la célula receptora; nombrar la papila por sí solo deja incompleto el mecanismo.',619),
  leaf('Dos mecanismos en esta edición','Saladin presenta sodio y ácidos como estímulos que despolarizan directamente la célula, mientras azúcares, alcaloides y glutamato activan receptores asociados a proteínas G y segundos mensajeros. Se conserva el nivel de detalle de esta edición: no se añaden aquí canales o moléculas de otras fuentes.',621),
  leaf('Salida sináptica y señal nerviosa','Ambas rutas modifican la respuesta de la célula gustativa y su liberación de neurotransmisor. Las fibras sensitivas de la base reciben esa señal y conducen la información hacia el tronco encefálico. El potencial de acción de la vía pertenece a la neurona aferente, no a una papila entendida como si fuese una neurona.',621)),
 branch('Nervios y primer relevo',
  leaf('VII: dos tercios anteriores','El facial recoge información gustativa de los dos tercios anteriores de la lengua. Este territorio no debe confundirse con toda su sensibilidad al contacto: el texto relaciona la textura con el nervio lingual, rama del trigémino. Modalidad gustativa y sensibilidad somática pueden compartir región anatómica sin viajar por la misma vía.',621),
  leaf('IX y X: otros territorios','El glosofaríngeo lleva gusto del tercio posterior; el vago participa desde regiones como faringe y epiglotis. Esta distribución permite seguir la procedencia de la señal antes de su convergencia central. No se asigna al vago la función de recoger todos los botones de la lengua ni al facial todo el tercio posterior.',621),
  leaf('Núcleo solitario: bulbo raquídeo','Las aferencias gustativas convergen en el núcleo solitario del bulbo. Desde ese relevo la información puede seguir hacia destinos relacionados con percepción y con respuestas autónomas. Por tanto, la vía no salta directamente del botón a la corteza: debe distinguirse el primer nervio de su primer relevo encefálico.',621)),
 branch('Corteza, reflejos e integración',
  leaf('Del tálamo a percepción consciente','Desde el núcleo solitario se retransmite información al tálamo y de allí a ínsula y región poscentral, según la descripción del libro. Este recorrido permite adquirir conciencia del gusto. Dibujar sólo una flecha a un cerebro genérico omite los relevos y no explica dónde se transforma la señal en percepción.',621),
  leaf('Hipotálamo y amígdala','Otras proyecciones se relacionan con respuestas autónomas como salivación y respuestas de rechazo. No toda salida gustativa termina en una decisión consciente. La separación entre una rama perceptiva y otra autonómica ayuda a explicar por qué un alimento puede desencadenar respuestas corporales además de una sensación identificable.',621),
  leaf('Corteza orbitofrontal: integración','La señal procesada se integra con información olfativa y visual en la corteza orbitofrontal. El resultado contribuye a la impresión del alimento y su atractivo. Reconstruye el trayecto completo: sustancia en saliva, botón, célula epitelial, fibra aferente, VII/IX/X, núcleo solitario, relevos superiores e integración cortical.',621))]),
'04':('Audición: anatomía, transducción y vía',[
 branch('Oído externo: captar y conducir',
  leaf('Aurícula y conducto auditivo','La aurícula orienta las vibraciones hacia el conducto auditivo externo. El conducto las conduce a la membrana timpánica; su piel, pelos y cerumen contribuyen a protegerlo. Todavía se trata de una vibración mecánica transportada por aire, no de potenciales de acción que nazcan en la piel de la oreja.',625),
  leaf('Membrana timpánica: frontera funcional','El tímpano vibra por las variaciones de presión y transmite el movimiento al martillo. Separa el conducto externo de la cavidad timpánica. Para entender una alteración conductiva debe seguirse la continuidad mecánica entre aire, tímpano y huesecillos, antes de llegar al receptor del oído interno.',625),
  leaf('Frecuencia y amplitud no son lo mismo','La frecuencia de la onda se relaciona con el tono; la amplitud, con su intensidad y sonoridad percibida. Un sonido agudo no es necesariamente fuerte. Estas dos propiedades requieren códigos diferentes en la cóclea y en la actividad de sus aferentes, que se desarrollan en la rama de codificación.',625)),
 branch('Oído medio: transmisión mecánica',
  leaf('Martillo, yunque y estribo','El martillo se une al tímpano y transmite el movimiento al yunque; éste lo transmite al estribo, cuya base ocupa la ventana oval. Esta cadena acopla la vibración del aire con el movimiento del líquido del oído interno. La ventana redonda no es el punto donde se fija la base del estribo.',626),
  leaf('Trompa auditiva: igualar presión','La trompa comunica la cavidad timpánica con la nasofaringe y se abre, por ejemplo, al deglutir. Facilita igualar la presión a ambos lados del tímpano para que pueda vibrar. No debe confundirse con el conducto auditivo externo: tienen comunicaciones y funciones anatómicas diferentes.',625),
  leaf('Concentración de energía y reflejo','La energía recogida por el tímpano se transmite a un área menor en la ventana oval, aumentando la presión aplicada al líquido. El tensor del tímpano y el músculo del estribo pueden reducir la transmisión. El reflejo tiene límites temporales y no garantiza protección frente a todo ruido intenso.',629)),
 branch('Oído interno: cóclea y receptor',
  leaf('Laberintos, escalas y líquidos','El laberinto membranoso contiene endolinfa y está rodeado por perilinfa dentro del laberinto óseo. En la cóclea, las escalas vestibular y timpánica contienen perilinfa; el conducto coclear contiene endolinfa. Confundir ambos líquidos impide explicar por qué el potasio entra en la célula pilosa durante la estimulación.',626),
  leaf('Membranas y órgano de Corti','El órgano de Corti se sitúa sobre la membrana basilar del conducto coclear. Incluye células pilosas y de soporte; sobre sus superficies apicales se relaciona la membrana tectoria. La vibración del conjunto modifica la inclinación de los estereocilios y conecta el movimiento del líquido con la respuesta eléctrica receptora.',628),
  leaf('Internas frente a externas','El texto organiza las células pilosas internas en una fila y las externas en tres. Las internas proporcionan la mayor parte de la señal sensitiva que se escucha; las externas intervienen en el ajuste de la respuesta coclear. Son células receptoras epiteliales, diferentes de las neuronas del ganglio espiral.',628),
  leaf('Estereocilio y aferente: no confundir','Los estereocilios son prolongaciones apicales que se deforman mecánicamente; no son axones ni cilios motores que batan para generar el sonido. Las fibras nerviosas contactan la base de las células pilosas. Entre movimiento del haz apical y actividad del nervio debe producirse una respuesta celular y una sinapsis.',628)),
 branch('Transducción paso a paso',
  leaf('Presión a desplazamiento basilar','El estribo mueve la ventana oval y genera variaciones de presión en los líquidos cocleares. La membrana basilar se desplaza y la ventana redonda permite aliviar esa presión. La cadena completa empieza en el tímpano, pasa por huesecillos y líquidos y termina moviendo la estructura que sostiene a las células pilosas.',630),
  leaf('Puentes apicales y entrada de K+','Al inclinarse el haz hacia los estereocilios más altos, aumenta la tensión de los puentes apicales y se abren canales mecánicos. La endolinfa es rica en potasio; su gradiente favorece la entrada de K+ y la despolarización. Aquí la entrada de potasio, y no su simple salida, inicia la respuesta.',630),
  leaf('Despolarización y comunicación basal','La célula pilosa despolarizada aumenta la liberación de neurotransmisor en su base y modifica la actividad de la neurona aferente. La señal conducida por el nervio coclear es una salida posterior a esa sinapsis. Inclinación del haz, potencial de receptor y potencial de acción del nervio son pasos distintos.',630),
  leaf('Movimiento contrario y patrón temporal','Cuando el haz se inclina en sentido opuesto se reduce la apertura de canales y disminuye la respuesta excitadora. Las oscilaciones mecánicas se traducen así en cambios temporales de la señal. No basta escribir «vibración produce impulso»: deben explicarse la dirección del movimiento, el canal y la salida sináptica.',630)),
 branch('Codificación y alteraciones',
  leaf('Tono: base y ápice','La membrana basilar cambia de propiedades a lo largo de la cóclea. Su región basal, más estrecha y rígida, responde mejor a frecuencias altas; la región apical, más ancha y flexible, a bajas. El sistema utiliza el lugar de mayor actividad para discriminar tono: no inviertas base y ápice.',631),
  leaf('Intensidad: frecuencia y reclutamiento','Una vibración más intensa aumenta la respuesta de las células pilosas y la frecuencia de actividad en sus aferentes; también puede activar una región más amplia. El encéfalo interpreta el patrón combinado. Esto no significa que cada potencial de acción del nervio se haga proporcionalmente más alto.',631),
  leaf('Modulación y comparación binaural','Las células pilosas externas y las proyecciones eferentes participan en ajustar el contraste de la respuesta coclear. Más adelante, los centros del tronco comparan información de ambos oídos para localizar el sonido. Afinar la respuesta local y comparar los dos lados son procesos relacionados, pero no ocurren en el mismo punto.',632),
  leaf('Conductiva frente a neurosensitiva','La alteración conductiva interfiere con la llegada de la vibración al oído interno, por ejemplo por una obstrucción del conducto o un problema timpánico. La neurosensitiva afecta células pilosas o elementos nerviosos. La distinción se basa en el eslabón alterado; este esquema es conceptual y no diagnostica por sí solo una pérdida auditiva.',633)),
 branch('Vía auditiva hasta la corteza',
  leaf('Ganglio espiral y nervio VIII','Las neuronas aferentes bipolares tienen sus somas en el ganglio espiral. Reciben señales en la base de las células pilosas y sus axones centrales forman el nervio coclear. Éste se une al componente vestibular para integrar el VIII par, pero la información auditiva debe distinguirse de la información de equilibrio.',633),
  leaf('Relevos del tronco encefálico','La vía alcanza los núcleos cocleares del bulbo y continúa por conexiones bilaterales hacia centros como la oliva superior y los colículos inferiores del mesencéfalo. La oliva participa en comparar señales de ambos oídos; los colículos contribuyen a localización y respuestas al sonido. No todo axón sigue una única cadena lineal idéntica.',633),
  leaf('Tálamo y corteza temporal','Desde los relevos mesencefálicos la señal alcanza el tálamo y después la corteza auditiva primaria, en la región superior del lóbulo temporal, profunda respecto a la cisura lateral. Allí participa en la percepción consciente. La ruta termina en territorio auditivo temporal, no en la corteza visual occipital.',633),
  leaf('Por qué importa la bilateralidad','Tras los relevos iniciales existen abundantes conexiones y cruces entre lados. Por eso una lesión cortical auditiva unilateral no equivale simplemente a dejar sordo el oído opuesto. Reconstruye el trayecto desde célula pilosa hasta corteza y explica en cada relevo qué se está transmitiendo o procesando.',633))]),
'06':('Visión: del ojo a la corteza',[
 branch('Anatomía y medios ópticos',
  leaf('Tres túnicas del globo ocular','La túnica fibrosa comprende esclerótica y córnea; la vascular o úvea incluye coroides, cuerpo ciliar e iris; la interna contiene la retina. Cada capa tiene funciones distintas: soporte y transparencia anterior, nutrición y regulación óptica, y recepción/procesamiento de señales. No son tres nombres intercambiables de la retina.',641),
  leaf('Trayecto de la luz','La luz atraviesa córnea, humor acuoso, pupila, cristalino y cuerpo vítreo para alcanzar la retina. La córnea aporta la mayor refracción; el cristalino ajusta el enfoque. La pupila es la abertura del iris, no una lente independiente, y la retina recibe la imagen después de atravesar esos medios transparentes.',642),
  leaf('Humor acuoso y cámaras','El cuerpo ciliar secreta humor acuoso hacia la cámara posterior; el líquido cruza la pupila, pasa a la cámara anterior y se drena hacia el seno venoso escleral. La cámara posterior está entre iris y cristalino, mientras la gran cavidad detrás del cristalino contiene vítreo. No confundas ambos espacios.',642),
  leaf('Fóvea, mácula y disco óptico','La fóvea ocupa el centro de la mácula y permite visión muy detallada. El disco óptico es el lugar de salida de axones y paso de vasos, sin fotorreceptores para formar imagen: origina el punto ciego. Son regiones retinianas diferentes; la mayor agudeza no se localiza en el disco de salida del nervio.',643)),
 branch('Enfoque, pupila y acomodación',
  leaf('Córnea y cristalino: contribuciones distintas','La córnea desvía intensamente los rayos al pasar del aire al ojo; el cristalino afina el enfoque, sobre todo al cambiar la distancia del objeto. Una imagen nítida requiere que el foco coincida con la retina. Cambiar solamente la cantidad de luz mediante la pupila no sustituye la refracción y la acomodación.',644),
  leaf('Visión cercana: tres ajustes','La respuesta de cerca combina convergencia de los ojos, constricción de las pupilas y acomodación del cristalino. La convergencia orienta ambos ejes hacia el mismo objeto; la pupila pequeña reduce rayos periféricos; el cristalino más convexo ayuda a enfocar rayos divergentes de un objeto cercano.',645),
  leaf('Músculo ciliar y ligamento','Al mirar de cerca se contrae el músculo ciliar, disminuye la tensión del ligamento suspensorio y el cristalino adquiere mayor convexidad. En visión lejana ocurre el patrón inverso y se aplana. No dibujes contracción ciliar tensando más el ligamento para visión cercana: invierte la relación mecánica descrita.',646),
  leaf('Reflejo pupilar y percepción','La luz puede activar rutas hacia la región pretectal y una salida parasimpática que viaja por el III par hasta el ganglio ciliar y el constrictor pupilar. La respuesta consensual afecta ambas pupilas. Esta vía refleja debe distinguirse de la ruta que termina en corteza occipital para visión consciente.',644)),
 branch('Retina: células y ubicación',
  leaf('Epitelio pigmentario y fotorreceptores','El epitelio pigmentario está junto a los segmentos externos de bastones y conos, hacia la pared posterior. Absorbe luz sobrante y participa en la eliminación de discos receptores antiguos. Los segmentos externos contienen pigmentos; las regiones internas albergan organelos y se continúan con la zona celular y sináptica.',647),
  leaf('Bastones: sensibilidad con luz tenue','Los bastones contienen rodopsina y participan en visión escotópica sin discriminación de color. Su convergencia permite sumar señales débiles, a costa de menor resolución espacial. La sensibilidad nocturna no significa que cada bastón sea responsable de identificar por separado todos los detalles de una imagen fina.',651),
  leaf('Conos: color y agudeza','Los conos permiten visión fotópica y discriminación del color. En la fóvea hay alta resolución y poca convergencia; fuera de ella la organización cambia. Esta edición sitúa los máximos de sensibilidad de S, M y L en 420, 531 y 558 nm. Son sensibilidades superpuestas, no tres detectores de colores exclusivos.',652),
  leaf('Bipolares, ganglionares y salida','Las células bipolares reciben la información de los receptores y la transmiten hacia ganglionares. Las ganglionares están hacia el lado vítreo y sus axones forman el nervio óptico. El trayecto de la señal receptora hacia estas células no es el mismo que el recorrido de entrada de los rayos de luz.',648),
  leaf('Horizontales, amacrinas y glía','Horizontales y amacrinas establecen conexiones laterales entre circuitos retinianos y contribuyen al contraste, contornos y cambios de iluminación. La glía da soporte al tejido. Incluir estas células evita reducir la retina a una cadena de tres nombres que omite el procesamiento que ocurre antes de salir del ojo.',648)),
 branch('Fototransducción y adaptación',
  leaf('Pigmento: opsina y retinal','La rodopsina de los bastones contiene opsina y retinal, derivado de vitamina A. La luz modifica la configuración del retinal y activa una cascada asociada al pigmento; la figura del libro incluye la reducción del cGMP. La regeneración recupera pigmento funcional, por lo que absorción de luz y recuperación son procesos diferentes.',649),
  leaf('Oscuridad y luz: cambia la secreción','En oscuridad el bastón libera glutamato de forma sostenida. La luz reduce esa liberación y cambia la respuesta de las células bipolares. El ejemplo de la figura 16.38 muestra una bipolar que se activa cuando disminuye la inhibición, pero el libro aclara que otras bipolares responden de manera diferente; no universalices un solo circuito.',650),
  leaf('La señal del nervio óptico','Las respuestas graduadas de los receptores y de los circuitos retinianos modifican la frecuencia de actividad de las células ganglionares. Sus axones conducen la salida hacia el encéfalo. Así se distinguen absorción de luz, comunicación sináptica dentro de la retina y conducción del potencial de acción fuera de ella.',651),
  leaf('Adaptación a luz y oscuridad','Al pasar a luz intensa cambian la pupila y el estado de los pigmentos; los conos predominan en iluminación alta. Al entrar en oscuridad, la recuperación de rodopsina aumenta progresivamente la sensibilidad de los bastones. El texto aproxima veinte a treinta minutos para máxima sensibilidad nocturna; el ajuste no depende sólo del diámetro pupilar.',651)),
 branch('Proyección y percepción visual',
  leaf('Nervio, quiasma y cintillas','Los axones ganglionares salen por el nervio óptico y llegan al quiasma. Cruzan las fibras procedentes de las mitades nasales de las retinas, mientras las temporales permanecen del mismo lado. Las cintillas llevan información de un hemicampo visual, no simplemente todo lo que ve un único ojo.',654),
  leaf('Tálamo y corteza occipital','La mayor parte de la información para visión consciente releva en el núcleo geniculado lateral del tálamo. Desde allí las radiaciones ópticas alcanzan la corteza visual primaria del lóbulo occipital. El esquema y la figura 16.43 muestran destinos a ambos lados; no se interpreta como una terminación exclusiva en el tálamo izquierdo.',654),
  leaf('Campo visual contralateral','El hemisferio derecho procesa el hemicampo visual izquierdo y el izquierdo, el derecho. Esta organización se explica combinando la proyección óptica de la imagen sobre cada hemirretina con el cruce parcial del quiasma. No significa que el ojo derecho proyecte únicamente al hemisferio izquierdo.',654),
  leaf('Profundidad e integración binocular','Los dos ojos observan un objeto desde ángulos diferentes. La comparación de sus imágenes en campos superpuestos permite estimar profundidad. La convergencia y la correspondencia de las imágenes son importantes: una alteración de alineación puede producir visión doble aunque la retina de cada ojo siga recibiendo luz.',653)),
 branch('Alteraciones: mecanismo y estructura',
  leaf('Miopía e hipermetropía','En la miopía el foco queda delante de la retina; en la hipermetropía, detrás. El cuadro relaciona estos patrones con un ojo relativamente largo o corto. La figura 16.33 distingue corrección divergente cóncava para miopía y convergente convexa para hipermetropía. Se sigue la figura, ya que una frase del cuadro de esta edición invierte el término para miopía.',646),
  leaf('Presbicia y astigmatismo','La presbicia es reducción de la capacidad de acomodación de cerca por pérdida de flexibilidad del cristalino con la edad. El astigmatismo implica diferente enfoque según el plano de entrada de la luz, asociado a la forma de la córnea en el texto. Son mecanismos diferentes: no todo desenfoque se explica por longitud del globo ocular.',646),
  leaf('Catarata: transparencia del cristalino','La catarata consiste en opacificación del cristalino, que altera el paso de luz y la calidad de imagen. El problema central es la transparencia del medio, no una papila, un receptor gustativo ni un cambio de territorio del nervio óptico. Esta relación estructura-función permite distinguirla de un defecto puramente refractivo.',642),
  leaf('Glaucoma: relación con humor acuoso','El recuadro del libro explica un mecanismo de daño asociado a alteración del drenaje del humor acuoso y aumento de presión intraocular. Se presenta como el mecanismo descrito en esta edición, sin convertirlo en una definición exhaustiva de toda forma de glaucoma ni añadir criterios diagnósticos o tratamientos de otras fuentes.',642),
  leaf('Retina, color y alineación','El libro también trata desprendimiento de retina, alteración de fotopsinas en daltonismo y diplopía por falta de alineación adecuada. Localiza cada problema: separación del tejido receptor, discriminación cromática o correspondencia binocular. La misma queja de «ver mal» puede relacionarse con estructuras y procesos muy diferentes.',652))])
}

def main():
 sha=hashlib.sha256(BOOK.read_bytes()).hexdigest()
 import pypdfium2 as pdf
 book=pdf.PdfDocument(str(BOOK))
 figures={'01':(614,(38,68,575,419)),'03':(620,(35,60,580,510)),'04':(626,(40,68,570,305)),'06':(641,(55,65,583,418))}
 for suffix,(title,sections) in MAPS.items():
  id='morfo_16_organos_sentidos__'+suffix
  page,bounds=figures[suffix]
  figure=book[page-1].render(scale=2).to_pil().crop(tuple(v*2 for v in bounds))
  figure.save(ROOT/f'assets/mindmaps/premium-illustrations/{id}-r2.webp',quality=94)
  p=ROOT/'api/_mindmaps'/f'{id}.json';old=json.loads(p.read_text(encoding='utf-8'))
  for i,s in enumerate(sections):s['color']=COLORS[i]
  pages=sorted({x['source']['pdfPage'] for s in sections for g in s['groups'] for x in g['items']})
  old.update(title=title,sections=sections)
  if suffix=='06':sections[-1]['groups'][0]['items'][-1]['source']['pdfPages']=[643,645,652]
  old['assets'].update(image=f'/assets/mindmaps/premium-illustrations/{id}-r2.webp',alt={'01':'Figura 16.2: receptores de los sentidos generales','03':'Figura 16.6: lengua, papilas y botón gustativo','04':'Figura 16.11: anatomía del oído externo, medio e interno','06':'Figura 16.25: corte sagital del ojo'}[suffix],source={'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPages':pages,'book_sha256':sha,'kind':'original_synthesis'},download='/api/mindmap?id='+id+'&format=image')
  old['review']={'state':'automated_review_passed','doctor_approved':False,'scope':'Specific requested anatomy, cell/receptor locations, physiology, central routes and vision alterations. Supplied Saladin only. Native six-branch interactive design preserved. Full chapter approval pending.'}
  old['format']='interactive-mind-map';old['content_revision']=2
  p.write_text(json.dumps(old,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
  for f in ['content/mindmaps-premium-catalog.json','api/_mindmaps/native-senses-overrides.json']:
   q=ROOT/f
   data=json.loads(q.read_text(encoding='utf-8')) if q.exists() else []
   entry=next((m for m in data if m['id']==id),None)
   if not entry:
    if f.endswith('catalog.json'):raise ValueError(id)
    entry={'id':id};data.append(entry)
   entry.update(titulo=title,root_title=title,descripcion='Anatomía, receptores, mecanismos y recorrido de la señal. Síntesis del Saladin oficial.',format='interactive-mind-map',content_revision=2,preview='/assets/mindmaps/premium-previews/'+id+'.webp?v=2')
   q.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
 catalog=json.loads((ROOT/'content/mindmaps-premium-catalog.json').read_text(encoding='utf-8'))
 (ROOT/'mindmap-premium-catalog.js').write_text('/* Public metadata only; full resources require verified access. */\nwindow.MINDMAP_PREMIUM_CATALOG = '+json.dumps(catalog,ensure_ascii=False,separators=(',',':'))+';\n',encoding='utf-8')
 print(json.dumps({k:sum(len(g['items']) for s in v[1] for g in s['groups']) for k,v in MAPS.items()}))
if __name__=='__main__':main()
