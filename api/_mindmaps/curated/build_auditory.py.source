"""Auditory transduction: original synthesis and practice, protected authoring source."""
from pathlib import Path
import json
ROOT=Path(__file__).resolve().parents[3]
ID='morfo_16_organos_sentidos__08'
ROWS=[
 ('Del aire al movimiento coclear',[
  ('Una cadena mecánica, todavía sin señal neural','El sonido hace vibrar la membrana timpánica. Martillo, yunque y estribo transmiten movimiento hasta la ventana oval, donde el estribo desplaza el líquido coclear. Nombrar las estructuras no basta: hay que distinguir el estímulo acústico en aire del movimiento mecánico que llega al oído interno. La conversión sensorial ocurre después.',629),
  ('Dos ventanas con funciones diferentes','La ventana oval recibe el movimiento del estribo; la membrana de la ventana redonda permite compensar los cambios de presión del líquido. No son dos entradas equivalentes de aire a la cóclea. El movimiento alternante y la deformación de las estructuras cocleares importan más que imaginar un flujo unidireccional continuo de líquido.',630),
  ('Tres compartimentos, dos líquidos','Las escalas vestibular y timpánica contienen perilinfa; el conducto coclear o escala media contiene endolinfa. La membrana vestibular separa la escala media de la vestibular y la basilar la separa de la timpánica. Conservar estas separaciones permite mantener ambientes iónicos distintos, necesarios para la transducción.',627)]),
 ('Órgano de Corti: estructura y tarea',[
  ('Dónde está el receptor','El órgano de Corti se encuentra sobre la membrana basilar, dentro del conducto coclear. Incluye células pilosas, células de soporte y relaciones con membranas próximas. No es un agujero en la membrana ni otro nombre para el nervio: es el epitelio sensorial que vincula vibración y respuesta celular.',627),
  ('Internas y externas no son intercambiables','Las células pilosas internas aportan la mayor parte de la información sensitiva que sale por el nervio coclear. Las externas participan en la regulación mecánica y la selectividad de la respuesta coclear. Las dos poblaciones son necesarias para comprender el funcionamiento, pero no deben dibujarse como receptores idénticos con la misma contribución aferente.',628),
  ('Estereocilios no son cilios motores','Son prolongaciones apicales que se organizan en un haz escalonado. Su flexión modifica la apertura de canales mecanosensibles. El estímulo relevante es el desplazamiento relativo del haz, no un batido activo de cilios que empuje el sonido hacia el encéfalo. En el esquema se destaca una dirección excitadora y su dirección opuesta.',628)]),
 ('Deformación, canales y potencial receptor',[
  ('Hacia los estereocilios más altos','La flexión en esta dirección aumenta la tensión de los enlaces apicales y favorece la apertura de canales mecanosensibles. El acoplamiento transforma una fuerza mecánica en un cambio de conductancia. La dirección contraria reduce esa apertura; por eso el receptor responde al sentido de la deformación, no solo a que exista movimiento.',630),
  ('Por qué puede entrar potasio','La endolinfa que baña la región apical es rica en K+ y tiene un potencial positivo respecto a la perilinfa. Junto con el interior negativo de la célula, esto favorece la entrada de carga positiva al abrirse los canales. No hay que trasladar automáticamente la regla simplificada de que el K+ siempre sale de una célula.',630),
  ('Despolarización graduada, no impulso en la célula pilosa','La corriente entrante cambia el potencial de la célula receptora de forma graduada. Una mayor respuesta receptora puede modificar la liberación sináptica; no consiste en que esta célula dispare un tren de potenciales de acción por un axón propio. La célula pilosa y la neurona aferente son elementos distintos.',630)]),
 ('De la célula pilosa al nervio',[
  ('Dos lugares de entrada iónica','El paso apical relacionado con el haz permite corriente catiónica, predominantemente de K+ en ese ambiente. La despolarización favorece después la apertura de canales de Ca2+ dependientes de voltaje en la región basal. El detalle de Ca2+ amplía el esquema resumido del Saladin y se contrasta con Neuroscience, NBK10867.',630),
  ('La sinapsis mantiene separados receptor y neurona','El aumento de Ca2+ intracelular en la región sináptica favorece la liberación de neurotransmisor desde la célula pilosa hacia la terminación aferente. La transmisión entre ambas células es química; no se dibuja como si sus citoplasmas formaran un único conducto. El esquema no necesita inventar otra sinapsis a continuación dentro del mismo axón.',630),
  ('Dónde aparecen los potenciales de acción','La señal de la célula pilosa modifica la actividad de la neurona sensitiva conectada a ella. Los potenciales de acción se propagan por la fibra coclear; su amplitud no representa directamente cuán fuerte fue el sonido. Debe separarse el potencial graduado receptor de la frecuencia de descarga y del reclutamiento de fibras.',631)]),
 ('Tono e intensidad: dos preguntas distintas',[
  ('Base para frecuencias altas; ápice para bajas','La base de la membrana basilar es relativamente estrecha y rígida; hacia el ápice aumenta su anchura y flexibilidad. El lugar del máximo desplazamiento depende de la frecuencia. Esta organización espacial permite relacionar una región estimulada con el tono, sin suponer que cada sonido mueve toda la membrana con la misma amplitud.',631),
  ('Más intenso no significa más agudo','Un aumento de intensidad puede producir mayor desplazamiento, cambios en la frecuencia de descarga y activación de una región más amplia. Si la frecuencia del estímulo se mantiene, no se convierte por ello en un tono más alto. Frecuencia acústica, intensidad acústica y frecuencia de disparo neural son variables relacionadas, pero diferentes.',631),
  ('El esquema es una simplificación declarada','Una onda viajera y el procesamiento coclear no equivalen a un tubo por el que se desliza un solo impulso. La lámina separa etapas para aprender sus relaciones y no representa proporciones anatómicas exactas. Tampoco pretende cubrir toda la vía auditiva central ni el equilibrio vestibular: estos son objetivos posteriores.',631)]),
 ('Casos para reconstruir el mecanismo',[
  ('Caso: desaparece la diferencia iónica apical','Aunque el haz pudiera flexionarse, alterar el gradiente entre endolinfa y célula puede reducir la corriente receptora y su efecto sobre la sinapsis. El caso permite identificar que la energía mecánica no basta sin el ambiente electroquímico. No autoriza a diagnosticar una causa clínica concreta a partir de una sola alteración teórica.',630),
  ('Caso: se conserva el receptor, falla su liberación basal','Si la célula aún desarrolla un potencial receptor, pero no libera adecuadamente neurotransmisor, la fibra aferente no recibirá la señal normal. El lugar de la falla es distinto del cierre de canales apicales. La secuencia causal ayuda a separar transducción mecanoeléctrica de transmisión sináptica.',630),
  ('Caso: misma frecuencia, mayor intensidad','La respuesta no debe justificarse como un potencial de acción de mayor tamaño. Hay que explicar mayor estimulación receptora, cambios en actividad de fibras y reclutamiento, manteniendo la distinción con la posición tonotópica. Esta interpretación responde a un ejercicio fisiológico, no a una prueba diagnóstica individual.',631)])]

CARDS=[
 ('¿Qué cambia al pasar del tímpano a la ventana oval?','La vibración se transmite por los huesecillos desde una membrana movilizada por aire hasta la interfaz con el líquido coclear. El estribo actúa en la ventana oval. Todavía se describe transmisión mecánica: no se ha sustituido el estímulo por una señal en el nervio coclear.',[629,630]),
 ('¿Por qué ventana oval y ventana redonda no cumplen la misma función?','La oval recibe el desplazamiento del estribo. La membrana de la redonda compensa cambios de presión del sistema líquido, permitiendo movimiento. Presentarlas como dos orificios por los que entra sonido de forma equivalente oculta la relación mecánica que hace posible la deformación coclear.',[627,630]),
 ('Reconstruye los tres compartimentos cocleares y sus líquidos.','Escala vestibular y escala timpánica: perilinfa. Conducto coclear o escala media: endolinfa. La membrana vestibular y la basilar delimitan la escala media. Esta separación conserva diferencias químicas; mezclar los líquidos en un dibujo impide explicar la corriente que participa en la respuesta receptora.',[627]),
 ('¿Cómo se relacionan membrana basilar y órgano de Corti?','El órgano de Corti se apoya en la membrana basilar dentro del conducto coclear. El movimiento de esa base participa en el desplazamiento relativo que flexiona los haces. No es una cámara vacía ni una fibra nerviosa: es una estructura sensorial con células pilosas y de soporte.',[627,628]),
 ('¿Qué dirección de flexión del haz favorece la respuesta excitadora?','La flexión hacia los estereocilios más altos aumenta la tensión de los enlaces apicales y favorece la apertura de canales mecanosensibles. La flexión opuesta reduce la apertura. Por eso es necesario indicar dirección, y no responder únicamente que cualquier movimiento produce una excitación idéntica.',[630]),
 ('¿Por qué abrir canales apicales permite despolarización por entrada de K+?','La endolinfa apical es rica en K+ y positiva respecto a la perilinfa; el interior celular es negativo. El gradiente electroquímico favorece la entrada de carga positiva al abrirse los canales. La dirección no se decide memorizando que el potasio siempre debe salir de las células.',[630]),
 ('Distingue la entrada apical de K+ de la entrada basal de Ca2+.','El movimiento del haz favorece corriente catiónica apical y despolariza el receptor. Esta despolarización abre canales de Ca2+ basales dependientes de voltaje, favoreciendo liberación de neurotransmisor. El Ca2+ basal es un detalle sináptico complementario al esquema del Saladin; no sustituye al paso mecanosensible del haz.',[630]),
 ('¿Dónde se produce la respuesta graduada y dónde se propagan potenciales de acción?','La célula pilosa desarrolla un potencial receptor graduado y modifica su liberación sináptica. La neurona aferente conectada a ella conduce potenciales de acción por la fibra coclear. No hay un axón propio del receptor que se convierta directamente en nervio; son células distintas conectadas por una sinapsis.',[628,630,631]),
 ('¿Qué relación hay entre posición en la membrana basilar y frecuencia acústica?','Las frecuencias altas producen su máximo hacia la base, más estrecha y rígida. Las bajas lo hacen más hacia el ápice, más ancho y flexible. El lugar de máxima respuesta contribuye a codificar el tono; no debe confundirse con la frecuencia de disparo de una sola neurona.',[631]),
 ('¿Por qué aumentar intensidad no equivale a aumentar amplitud de cada potencial de acción?','Los potenciales de acción no codifican intensidad mediante un tamaño creciente. Un estímulo más intenso puede aumentar la respuesta receptora, la frecuencia de descarga y el número de fibras activadas. Tampoco implica necesariamente un tono más agudo si la frecuencia acústica del estímulo permanece constante.',[631])]

QUESTIONS=[
 ('En un modelo, el haz se flexiona hacia los estereocilios más altos. ¿Cuál es el primer vínculo eléctrico esperado?', ['Mayor apertura de canales mecanosensibles y corriente entrante','Cierre obligatorio de todos los canales y pérdida de corriente','Un potencial de acción en el axón propio de la célula pilosa','Aumento de Ca2+ basal sin cambio previo del potencial receptor'],0,[
 'Correcto: la dirección excitadora favorece apertura mecanosensible; la corriente apical inicia el cambio del potencial receptor.',
 'Invierte el sentido de la respuesta. La flexión contraria es la que reduce la apertura del haz.',
 'Confunde célula receptora con neurona aferente. La célula pilosa no conduce por un axón propio hacia el encéfalo.',
 'Omite el enlace causal entre corriente apical, despolarización y apertura basal de canales dependientes de voltaje.'],[630]),
 ('¿Qué asociación de líquido y compartimento conserva la organización coclear?', ['Perilinfa en las tres escalas','Endolinfa en la escala media; perilinfa en vestibular y timpánica','Endolinfa en la timpánica y perilinfa en la media','Endolinfa solo en la escala vestibular'],1,[
 'Elimina la diferencia de la escala media y no permite representar el ambiente apical rico en K+.',
 'Correcto: el conducto coclear contiene endolinfa y las otras dos escalas contienen perilinfa, separadas por membranas.',
 'Intercambia la composición de los compartimentos que el enunciado pide distinguir.',
 'Ubica la endolinfa en una escala que contiene perilinfa y deja fuera el conducto coclear.'],[627]),
 ('Se conserva el potencial receptor, pero se reduce mucho la liberación basal de neurotransmisor. ¿Qué etapa está afectada de manera más directa?', ['La entrada del sonido por el conducto auditivo','El movimiento inicial del tímpano','La comunicación sináptica con la neurona aferente','La selección del lugar tonotópico por la frecuencia'],2,[
 'La hipótesis conserva una respuesta receptora; no aporta una falla de entrada acústica externa.',
 'No es la etapa descrita: el problema se sitúa después de que la célula haya desarrollado un potencial receptor.',
 'Correcto: el potencial receptor puede existir mientras falla la transferencia química hacia la fibra aferente.',
 'La pregunta especifica un defecto de liberación; no describe un cambio del lugar de máximo desplazamiento.'],[630]),
 ('Manteniendo la frecuencia de un tono, se eleva su intensidad. ¿Cuál es el error que debe evitarse al explicarlo?', ['Considerar que puede aumentar la frecuencia de descarga neural','Considerar que puede participar una región receptora más amplia','Separar intensidad acústica de frecuencia acústica','Afirmar que cada potencial de acción aumenta de amplitud'],3,[
 'Es una posibilidad del código de intensidad; no constituye por sí misma el error pedido.',
 'El reclutamiento puede contribuir a la señal de intensidad y es compatible con la explicación fisiológica.',
 'Distinguir estas variables evita confundir un sonido más fuerte con uno necesariamente más agudo.',
 'Correcto: el error es atribuir la intensidad a un mayor tamaño de cada potencial de acción, en lugar de actividad y reclutamiento.'],[631]),
 ('¿Qué región de la membrana basilar se asocia mejor con el máximo de respuesta a frecuencias altas?', ['La base relativamente estrecha y rígida','El ápice relativamente ancho y flexible','La ventana redonda como único receptor sensorial','Toda la membrana con un máximo idéntico en cada punto'],0,[
 'Correcto: el gradiente mecánico favorece respuestas a frecuencias altas hacia la base; las bajas se representan más hacia el ápice.',
 'Describe la región más relacionada con frecuencias bajas y por eso invierte la tonotopía.',
 'La ventana redonda participa en la compensación mecánica de presión, no sustituye al epitelio sensorial.',
 'Niega la distribución espacial de la respuesta que permite relacionar posición y frecuencia.'],[631]),
 ('¿Qué afirmación distingue correctamente las dos poblaciones de células pilosas?', ['Las externas son la única fuente de aferencias y las internas solo sostienen el epitelio','Las internas aportan la mayor parte de la salida sensitiva; las externas modulan la respuesta mecánica','Ambas son neuronas con axones que forman directamente el nervio','Las internas responden solo a intensidad y las externas solo a frecuencia'],1,[
 'Intercambia la contribución sensitiva principal y confunde las internas con células de soporte.',
 'Correcto: identifica tareas diferentes sin tratar las externas como irrelevantes ni atribuirles la salida aferente predominante.',
 'Son receptores epiteliales que establecen sinapsis con neuronas; no son sus propios axones los que forman el nervio.',
 'Impone una división exclusiva que no representa cómo se integran mecánica, frecuencia e intensidad en la cóclea.'],[628,631])]

def main():
 sections=[{'title':title,'groups':[{'title':'Mecanismos y relaciones','items':[{'title':t,'text':text,'source':{'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPage':p,'kind':'original_synthesis'}} for t,text,p in rows]}]} for title,rows in ROWS]
 practice={'flashcards':[{'question':q,'answer':a,'pdf_pages':p} for q,a,p in CARDS],'questions':[{'question':q,'options':o,'correct':c,'reasons':r,'pdf_pages':p} for q,o,c,r,p in QUESTIONS],'source':'Saladin, capítulo 16 · PDF 627–631 (impresas 599–603). Detalle de Ca2+ basal: Neuroscience, NBK10867.','review':'Revisión automatizada de fuente, coherencia y diseño; revisión docente pendiente.','supplementary_reference':'https://www.ncbi.nlm.nih.gov/books/NBK10867/'}
 payload={'id':ID,'title':'Audición: del sonido a la señal nerviosa','topic':'Órganos de los sentidos','sections':sections,'assets':{'image':'/assets/mindmaps/illustrations/morfo_16_organos_sentidos.webp','alt':'Ilustración de apoyo de órganos de los sentidos','download':'/api/mindmap?id='+ID+'&format=image','filename':ID+'-Ben-Carson.webp','source':{'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPages':[627,628,629,630,631],'kind':'original_synthesis'},'generative_download':True,'practice':practice},'review':{'state':'automated_review_passed','doctor_approved':False,'clinical_diagnosis_tool':False,'scope':'Ampliación específica de transducción auditiva; no cubre equilibrio ni toda la vía central.'},'supplementary_reference':{'title':'Hair Cells and the Mechanoelectrical Transduction of Sound Waves','url':'https://www.ncbi.nlm.nih.gov/books/NBK10867/','scope':'Ampliación del detalle basal de Ca2+; no atribuir ese detalle al texto resumido del Saladin.'}}
 (ROOT/'api/_mindmaps'/(ID+'.json')).write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 metadata={'id':ID,'titulo':payload['title'],'root_title':payload['title'],'materia':'Morfofunción','tema':'Órganos de los sentidos','parent_key':'morfo_16_organos_sentidos.png','url_imagen':'premium/'+ID+'.json','descripcion':'Transmisión mecánica, transducción, sinapsis y codificación. Lámina ilustrada, explicaciones y práctica razonada.','premium':True,'acceso_gratis':False,'curated':True,'preview':'/assets/mindmaps/premium-previews/'+ID+'.webp'}
 for filename in ['mindmaps-curated-additions.json','mindmaps-premium-catalog.json']:
  p=ROOT/'content'/filename;rows=json.loads(p.read_text(encoding='utf8'));rows=[r for r in rows if r['id']!=ID]+[metadata];p.write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 catalog=json.loads((ROOT/'content/mindmaps-premium-catalog.json').read_text(encoding='utf8'));(ROOT/'mindmap-premium-catalog.js').write_text('/* Public metadata only. Full explanations and downloads require verified access. */\nwindow.MINDMAP_PREMIUM_CATALOG = '+json.dumps(catalog,ensure_ascii=False,separators=(',',':'))+';\n',encoding='utf8')
 print('Auditory map: 18 explanations, 10 flashcards, 6 reasoned questions.')
if __name__=='__main__':main()
