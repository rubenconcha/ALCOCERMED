"""Own-authored practice; full authoring content stays behind the private API route."""
import json
from pathlib import Path
ROOT=Path(__file__).resolve().parents[3]

def card(q,a,p): return dict(question=q,answer=a,pdf_pages=p)
def question(q,options,correct,reasons,p):
    return dict(question=q,options=options,correct=correct,reasons=reasons,pdf_pages=p)

BLOOD={
 'flashcards':[
 card('¿Por qué un 65 % de neutrófilos no basta para conocer cuántos circulan?', 'El porcentaje es una fracción del total de leucocitos, no una concentración. Con 8 000 leucocitos/µl, 0,65 × 8 000 = 5 200 neutrófilos/µl; con 2 000, el mismo porcentaje corresponde a 1 300/µl. Para interpretar se necesitan recuento total, diferencial y referencia del laboratorio.',[726,729]),
 card('¿Cómo puede aumentar el porcentaje de linfocitos sin aumentar su número absoluto?', 'Si disminuyen otras poblaciones, cambia el denominador. Mantener 2 000 linfocitos/µl mientras el total baja de 8 000 a 4 000 hace que su proporción pase de 25 % a 50 %. Eso demuestra un aumento relativo; no demuestra proliferación de linfocitos.',[727,729]),
 card('Reconstruye los intervalos diferenciales del Saladin utilizado y explica su límite.', 'Neutrófilos 60–70 %, linfocitos 25–33 %, monocitos 3–8 %, eosinófilos 2–4 % y basófilos <0,5 %. Son intervalos orientativos del cuadro 18.6 de esta edición. No se suman todos los extremos superiores como si fueran un diferencial real; tampoco sustituyen las referencias por edad y laboratorio.',[726,727]),
 card('¿Qué rasgos permiten distinguir neutrófilo, eosinófilo y basófilo en un frotis teñido?', 'El neutrófilo tiene núcleo segmentado y gránulos finos; el eosinófilo suele mostrar dos lóbulos y gránulos naranja rosados; el basófilo contiene gránulos violeta oscuro que pueden ocultar el núcleo. Son pistas combinadas de identificación, no una prueba aislada de la enfermedad que padece la persona.',[726]),
 card('¿Por qué un neutrófilo necesita diapédesis y quimiotaxis para actuar en un foco tisular?', 'La diapédesis permite atravesar la pared del vaso; la quimiotaxis orienta el desplazamiento por señales químicas hacia el foco. Llegar al tejido y encontrar el blanco son pasos distintos. La fagocitosis describe después la captura e ingestión de partículas, no el cruce del endotelio.',[725]),
 card('¿Cómo se relaciona un monocito circulante con un macrófago tisular?', 'El monocito puede salir de la sangre y diferenciarse en macrófago. Este fagocita microorganismos y restos celulares y puede presentar antígenos, conectando eliminación de material con activación de otras células inmunitarias. La función tisular no queda reflejada por completo en un recuento de sangre periférica.',[727]),
 card('¿Por qué eosinofilia no equivale automáticamente a parasitosis?', 'Los eosinófilos participan en respuestas a determinados parásitos y también en procesos alérgicos y otros contextos. Un aumento es una pista que exige integrar historia y demás hallazgos. El diferencial no identifica por sí solo el agente causal ni permite escoger un tratamiento.',[726]),
 card('¿Qué diferencia hay entre leucopenia y anemia?', 'Leucopenia significa descenso de leucocitos; anemia se refiere a una capacidad reducida de transporte de oxígeno de la sangre, habitualmente valorada mediante hemoglobina y datos eritrocitarios. Un recuento leucocitario bajo no mide hemoglobina ni permite afirmar que también disminuyeron los eritrocitos.',[714,729]),
 card('¿Por qué no se puede identificar la función de todos los linfocitos solo por su aspecto?', 'Varias clases funcionales son indistinguibles en un frotis corriente. Los linfocitos participan en funciones diferentes: coordinación, citotoxicidad, memoria y producción de anticuerpos por la línea B diferenciada. El núcleo redondo y el citoplasma escaso ayudan a reconocer la población, pero no determinan todas sus subclases.',[727]),
 card('¿Un recuento leucocitario muy elevado garantiza una defensa eficaz?', 'No. La cantidad no informa por sí sola de madurez, función ni distribución tisular. Deben examinarse el diferencial, la morfología y el contexto. Las alteraciones proliferativas pueden aumentar células sin asegurar una respuesta inmunitaria competente; tampoco toda leucocitosis tiene ese origen.',[729,730])],
 'questions':[
 question('Un ejercicio presenta 8 000 leucocitos/µl y 65 % de neutrófilos. ¿Cuál es su recuento absoluto?', ['5 200 neutrófilos/µl','65 neutrófilos/µl','12 308 neutrófilos/µl','520 000 neutrófilos/µl'],0,['Correcto: 8 000 × (65/100) = 5 200 células/µl. El resultado conserva la unidad del recuento total.','Confunde la proporción con una concentración: 65 % no significa 65 células/µl.','Dividir entre 0,65 invierte la operación. Se busca una parte del total, no un total mayor.','Multiplica por 65 sin convertir el porcentaje en fracción; por eso introduce un factor de cien.'],[726,729]),
 question('Hay 2 000 linfocitos/µl en dos muestras. El total de leucocitos baja de 8 000 a 4 000/µl. ¿Qué conclusión aritmética es válida?', ['Se duplicaron los linfocitos absolutos','El porcentaje pasa de 25 % a 50 % sin cambiar el absoluto','Se confirma una leucemia','El número absoluto de linfocitos cayó a la mitad'],1,['El numerador sigue siendo 2 000; no se duplicó. Cambió el total usado como denominador.','Correcto: 2 000/8 000 = 0,25 y 2 000/4 000 = 0,50. Aumento relativo no equivale a aumento absoluto.','Estos dos números no establecen una etiología ni caracterizan células neoplásicas.','El dato de 2 000 linfocitos/µl se mantiene en ambas muestras; el descenso corresponde al total leucocitario.'],[727,729]),
 question('En un frotis se observa una célula con núcleo bilobulado y gránulos naranja rosados. ¿Cuál es la mejor identificación?', ['Basófilo','Monocito','Eosinófilo','Linfocito pequeño'],2,['Los gránulos del basófilo son intensamente oscuros y pueden ocultar el núcleo; no es la combinación descrita.','El monocito suele tener núcleo arriñonado y citoplasma abundante, sin los gránulos naranja rosados característicos.','Correcto: la combinación de núcleo bilobulado y granulación naranja rosada corresponde al eosinófilo en el cuadro 18.6.','En el linfocito pequeño domina un núcleo redondo con un borde estrecho de citoplasma; no la granulación indicada.'],[726,727]),
 question('Un leucocito ya atravesó el endotelio y ahora se orienta siguiendo señales químicas hacia el foco. ¿Cómo se llama este segundo proceso?', ['Fagocitosis','Degranulación','Diapédesis','Quimiotaxis'],3,['La fagocitosis consiste en ingerir material; no define la orientación del movimiento por un gradiente.','La degranulación libera contenido de gránulos; no define la orientación de la migración por señales químicas.','La diapédesis es el paso a través de la pared vascular, que en el enunciado ya terminó.','Correcto: la quimiotaxis orienta la migración por señales químicas. Es distinta del cruce vascular y de la ingestión posterior.'],[725]),
 question('El único dato disponible es un aumento de eosinófilos. ¿Qué razonamiento conserva el alcance del hallazgo?', ['Integrarlo con historia y otros datos porque admite varias causas','Diagnosticar siempre una parasitosis','Descartar cualquier proceso alérgico','Afirmar que subió el número absoluto sin conocer el total leucocitario'],0,['Correcto: la asociación con parásitos y alergias orienta posibilidades, pero el recuento no identifica por sí mismo una causa.','Convierte una asociación en diagnóstico exclusivo e ignora otras causas descritas.','Las respuestas alérgicas forman parte de los contextos asociados; no se excluyen por eosinofilia.','Si el aumento informado es porcentual, se necesita el total leucocitario para calcular la concentración absoluta.'],[726]),
 question('¿Qué combinación identifica correctamente los agranulocitos en la clasificación morfológica habitual?', ['Neutrófilos y eosinófilos','Linfocitos y monocitos','Eosinófilos y basófilos','Basófilos y neutrófilos'],1,['Ambos pertenecen a los granulocitos; los gránulos y el núcleo segmentado ayudan a reconocerlos.','Correcto: linfocitos y monocitos se clasifican como agranulocitos. El nombre no exige ausencia absoluta de todo gránulo microscópico.','Ambos son granulocitos, aunque tienen funciones y tinciones diferentes.','También son granulocitos; la escasa frecuencia del basófilo no cambia su clasificación.'],[724,726,727])]
}

RETINA={
 'flashcards':[
 card('¿En qué se oponen la dirección de entrada de luz y la vía neural en la retina?', 'La luz atraviesa capas internas antes de alcanzar los segmentos fotosensibles. La señal neural sigue el circuito fotorreceptor → bipolar → ganglionar, con procesamiento lateral adicional. Los axones ganglionares forman el nervio óptico. Una flecha sin rótulo puede confundir recorrido óptico con transmisión de información.',[647,648]),
 card('Explica el estado de un bastón en oscuridad sin llamarlo inactivo.', 'El GMPc favorece la apertura de canales catiónicos del segmento externo. La corriente entrante mantiene al bastón relativamente despolarizado y sostiene liberación de glutamato. Oscuridad no significa silencio sináptico: el cambio de iluminación modifica una señal que ya existe.',[649,650]),
 card('Reconstruye la respuesta del fotorreceptor a la luz en cuatro pasos.', 'La luz activa el fotopigmento; la cascada reduce GMPc; se cierran canales catiónicos y disminuye corriente entrante; el receptor se hiperpolariza y reduce la liberación de glutamato. No se debe sustituir esta respuesta graduada por un aumento de potenciales de acción en el bastón.',[649,650,651]),
 card('¿Por qué menos glutamato no significa necesariamente menos respuesta en todas las bipolares?', 'El efecto depende del receptor y de la vía. En las bipolares ON, disminuir glutamato permite despolarización; las vías OFF responden con otro signo. Es un cambio en la interpretación sináptica, no una inversión de la hiperpolarización que ocurre en el fotorreceptor.',[650]),
 card('Distingue blanqueado del pigmento y regeneración.', 'La absorción de luz cambia el retinal y activa el fotopigmento; el blanqueado se asocia a su descomposición. Recuperar rodopsina funcional requiere reconvertir retinal a su forma cis y reunirlo con opsina. La regeneración repone pigmento: no es un potencial de acción ni equivale a abrir todos los canales inmediatamente.',[649,650]),
 card('¿Por qué los bastones favorecen sensibilidad y los circuitos foveales detalle?', 'En el sistema de bastones la convergencia suma señales débiles, pero reduce precisión espacial. Los conos y la organización foveal permiten mayor resolución con luz suficiente. Sensibilidad para detectar poca luz y capacidad para separar detalles cercanos son propiedades distintas.',[651,652]),
 card('¿Qué células originan los axones del nervio óptico y qué implica?', 'Son las células ganglionares. La información ya ha pasado por circuitos retinianos antes de salir hacia el encéfalo. No existe una fibra óptica independiente para cada bastón y cada cono: la convergencia y el procesamiento modifican la relación entre receptores y salida.',[648,651]),
 card('¿Por qué dilatar la pupila no explica toda la adaptación a la oscuridad?', 'La dilatación permite entrar más luz, pero la sensibilidad retiniana también depende de regeneración de pigmentos y ajustes de los circuitos. Tras pasar de luz intensa a oscuridad, la recuperación visual es progresiva; un cambio óptico inmediato no completa por sí solo la adaptación celular.',[651]),
 card('¿Cuáles son los máximos de los conos S, M y L en esta edición y qué no significan?', 'El Saladin suministrado usa 420, 531 y 558 nm, respectivamente. Las curvas de sensibilidad se superponen: un cono no es un interruptor exclusivo para un color. El sistema compara actividad de distintas clases; estos máximos tampoco constituyen límites rígidos de visión.',[652]),
 card('Relaciona vitamina A, retinal y visión sin convertir una asociación en diagnóstico.', 'El retinal deriva de vitamina A y participa en los fotopigmentos. Su disponibilidad contribuye al ciclo visual. La dificultad para ver con poca luz puede tener causas diversas, por lo que no demuestra por sí sola una deficiencia ni indica automáticamente suplementación.',[649,651])],
 'questions':[
 question('Al iluminar un bastón, ¿qué secuencia describe la respuesta inicial del fotorreceptor?', ['GMPc sube → canales abren → despolarización','GMPc baja → canales cierran → hiperpolarización','El bastón dispara potenciales de acción hacia el nervio óptico','El glutamato aumenta porque la luz abre directamente los canales'],1,['Invierte el cambio de GMPc y de conductancia que caracteriza la respuesta a la luz.','Correcto: disminuye GMPc, se reduce corriente catiónica entrante, se hiperpolariza el receptor y baja su liberación de glutamato.','Confunde la respuesta graduada del receptor con la salida por axones ganglionares.','La luz actúa mediante el fotopigmento y una cascada; la liberación de glutamato disminuye en esta respuesta.'],[649,650,651]),
 question('La luz reduce glutamato del fotorreceptor y una bipolar ON se despolariza. ¿Cuál es la mejor explicación?', ['Todos los neurotransmisores siempre excitan','Todas las bipolares se despolarizan cuando baja el glutamato','La vía ON invierte el signo de la señal sináptica del fotorreceptor','El bastón se despolariza con la luz y aumenta su glutamato'],2,['El efecto depende del receptor postsináptico y del circuito; no existe esa regla universal.','Generaliza la respuesta ON a todas las bipolares e ignora las vías OFF, cuyo signo sináptico es diferente.','Correcto: retirar el efecto del glutamato sobre la vía ON permite despolarización. No contradice que el fotorreceptor se hiperpolarice.','Invierte el cambio inicial del fotorreceptor: la luz lo hiperpolariza y reduce su liberación de glutamato.'],[650]),
 question('¿Qué recorrido corresponde a la vía neural principal de salida, y no a la dirección de entrada de luz?', ['Ganglionar → bipolar → fotorreceptor','Fotorreceptor → ganglionar → bipolar','Bipolar → fotorreceptor → ganglionar','Fotorreceptor → bipolar → ganglionar'],3,['Invierte la vía neural principal representada; puede confundirse con el hecho de que la luz atraviesa capas internas.','Intercambia los niveles bipolar y ganglionar; la bipolar participa antes de la salida ganglionar en esta vía principal.','Coloca la bipolar antes del receptor y omite su papel de relevo después de la transducción.','Correcto: el receptor transduce, la bipolar participa en la transmisión y la ganglionar conduce la salida por su axón. Existen además circuitos laterales.'],[647,648,651]),
 question('Tras apagar la luz de una habitación brillante, ¿por qué la visión mejora progresivamente durante la oscuridad?', ['También se recuperan pigmentos y sensibilidad retiniana, además de dilatarse la pupila','Solo cambia el tamaño de la pupila; la retina no se adapta','Aumenta de inmediato la liberación de glutamato y eso completa toda la adaptación','El blanqueado de rodopsina supera a su regeneración durante la oscuridad'],0,['Correcto: la adaptación combina mecanismos ópticos y celulares; la regeneración de rodopsina contribuye a recuperar visión escotópica.','Omite procesos retinianos que explican la recuperación gradual después del ajuste pupilar.','El cambio inicial de señal al apagar la luz no completa la recuperación gradual de pigmentos y sensibilidad.','Invierte el balance: durante la recuperación en oscuridad, la regeneración repone rodopsina funcional.'],[650,651]),
 question('Para separar dos puntos muy próximos con iluminación suficiente, ¿qué organización resulta más favorable?', ['Mayor convergencia de muchos bastones sobre una salida','Circuitos de conos foveales con menor convergencia','Mayor sensibilidad del sistema de bastones a estímulos débiles','Un solo cono dedicado exclusivamente a cada color visible'],1,['La convergencia favorece detectar señales débiles, pero limita separar de qué receptor provienen estímulos próximos.','Correcto: la menor convergencia y organización foveal favorecen resolución espacial en visión con luz suficiente.','Detectar un estímulo débil no equivale a separar dos puntos próximos. La pregunta pide resolución espacial.','Las sensibilidades de las clases de conos se superponen; no hay un cono exclusivo para cada color visible.'],[651,652]),
 question('¿Cuál de estas afirmaciones distingue regeneración de pigmento y señal eléctrica?', ['Ambas expresiones significan disparar un potencial de acción en el bastón','Regenerar rodopsina destruye permanentemente el retinal','Regenerar repone fotopigmento funcional; hiperpolarizar cambia el potencial de membrana','La hiperpolarización significa que se regeneró toda la rodopsina'],2,['El bastón responde con cambios graduados; los fenómenos tampoco son sinónimos.','La regeneración recupera un pigmento funcional mediante el ciclo del retinal y su asociación con opsina.','Correcto: son procesos relacionados, pero uno se refiere al estado del pigmento y el otro a la membrana celular.','El cambio eléctrico no informa que todo el pigmento ya se haya regenerado; confunde variables y escalas del proceso.'],[649,650,651])]
}

def main():
 for ident,data in [('morfo_18_sangre__07',BLOOD),('morfo_16_organos_sentidos__07',RETINA)]:
  data['source']='Saladin, Anatomía y fisiología, capítulos 18 y 16. Páginas del PDF suministrado; página impresa = PDF − 28.'
  data['review']='Revisión automatizada de coherencia y contraste con la fuente; pendiente de revisión docente.'
  data['supplementary_reference']='https://www.ncbi.nlm.nih.gov/books/NBK10806/' if '16_' in ident else None
  target=ROOT/'api/_mindmaps'/(ident+'.json')
  payload=json.loads(target.read_text(encoding='utf8'));payload['assets']['practice']=data
  target.write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 print('20 flashcards and 12 reasoned questions integrated into protected maps.')
if __name__=='__main__':main()
