"""Append reviewed erythroid sections; preserve all fourteen previous pages."""
from pathlib import Path
from html import escape
import json,io
ROOT=Path(__file__).resolve().parents[3]
PAGES=[
{'title':'Plasma: leer una proporción sin inventar células','figure':'morfo_18_sangre__13.png','figure_height':320,'caption':'El dibujo ilustra capas; los valores del caso se calculan con la fórmula, no midiendo la imagen. Mapa ampliable en Sangre.','source':'Saladin, cap. 18, PDF 708-714 (libro 680-686). Modelo aritmético original.', 'blocks':[
('Caso: cambió el denominador','Un modelo contiene 45 unidades de eritrocitos y 55 de plasma. Si pierde 20 unidades solo de plasma, conserva los mismos eritrocitos en 80 de volumen total: el hematocrito pasa de 45 % a 56,25 %. El cambio no demuestra eritropoyesis. Si, en cambio, se agregan 25 unidades de plasma, el resultado es 45/125 × 100 = 36 %, sin pérdida eritrocitaria.'),
('Preparación y función no son la misma pregunta','El plasma procede de sangre anticoagulada; el suero se obtiene después de coagular y retirar el coágulo. Este paso no elimina todas las proteínas del líquido. Tampoco son equivalentes viscosidad, osmolaridad y presión oncótica: una se refiere a resistencia al flujo, otra a partículas por litro y la tercera al efecto osmótico proteico. Identificar la variable evita explicar un resultado con una medición diferente.') ]},
{'title':'Hemoglobina: conectar estructura y capacidad','figure':'morfo_18_sangre__14.png','figure_height':320,'caption':'Esquema de cuatro cadenas y un hemo por cadena. La deformación eritrocitaria representada no equivale a ruptura de membrana.','source':'Saladin, cap. 18, PDF 712-714 (libro 684-686). Verificación estructural complementaria: RCSB 4HHB y 1FDH.', 'blocks':[
('Caso: conservar las unidades','Una hemoglobina dispone de cuatro grupos hemo, cada uno capaz de unir una molécula de O2. Tres hemoglobinas completas tienen capacidad máxima para doce moléculas de O2, que contienen veinticuatro átomos de oxígeno. Eso no informa de la ocupación real de los sitios ni del número de eritrocitos de una muestra. Contar dos veces cadena y hemo produce una capacidad ficticia.'),
('Comparar variantes sin añadir subunidades','HbA reúne dos cadenas alfa y dos beta; HbA2 cambia el segundo par por delta y HbF por gamma. Se conserva el par alfa y el total de cuatro cadenas. La mayor afinidad atribuida a HbF no significa ocho sitios de O2. La descripción de la forma bicóncava también debe distinguir observación de hipótesis: el texto discute distintas explicaciones de su utilidad, sin establecer una única función indiscutible.') ]},
{'title':'EPO: seguir la señal hasta una respuesta posible','figure':'morfo_18_sangre__15.png','figure_height':320,'caption':'Reticulocito sin núcleo y con ARN residual. La secuencia es parcial; el órgano que señala no es el tejido que produce las células.','source':'Saladin, cap. 18, PDF 714-716 (libro 686-688). Precisión experimental renal: PMID 8857934.', 'blocks':[
('El circuito y su escala temporal','Menor disponibilidad de oxígeno renal favorece la señal de EPO. Los precursores eritroides de médula ósea roja responden mediante desarrollo y maduración; el eritroblasto expulsa el núcleo y el reticulocito conserva temporalmente ARN residual. No son eritrocitos maduros dividiéndose en sangre. Si mejora el aporte de oxígeno al riñón, disminuye el estímulo hipóxico inicial: eso explica la retroalimentación negativa, sin exigir desaparición de toda producción basal.'),
('Caso: señal no equivale a recursos ni reparación','El caso mantiene una señal estimulante pero limita un recurso para producir hemoglobina. No puede concluirse producción máxima: señal, recursos y capacidad medular son eslabones diferentes. B12 y folato participan en síntesis de ADN de precursores, no en una duplicación nuclear del eritrocito maduro. Tampoco más eritrocitos reparan automáticamente un pulmón alterado. El esquema no identifica una causa individual ni prescribe tratamiento.') ]}]

def extend(slug='sangre',title='Sangre',pages=None,accent='#ae354d'):
 from reportlab.pdfgen.canvas import Canvas
 from reportlab.pdfbase import pdfmetrics
 from reportlab.pdfbase.ttfonts import TTFont
 from reportlab.lib.pagesizes import A4
 from reportlab.lib.styles import ParagraphStyle
 from reportlab.platypus import Paragraph
 from reportlab.lib.colors import HexColor
 from reportlab.lib.utils import ImageReader
 from pypdf import PdfReader,PdfWriter
 page_specs=PAGES if pages is None else pages
 total=14+len(page_specs)
 target=ROOT/f'api/_pdf/morfofuncion-{slug}.pdf'
 base=PdfReader(io.BytesIO(target.read_bytes()))
 assert len(base.pages)>=14
 for name,font in [('Depth','arial.ttf'),('DepthBold','arialbd.ttf')]:
  if name not in pdfmetrics.getRegisteredFontNames():pdfmetrics.registerFont(TTFont(name,'C:/Windows/Fonts/'+font))
 pdfmetrics.registerFontFamily('Depth',normal='Depth',bold='DepthBold',italic='Depth',boldItalic='DepthBold')
 w,h=A4;m=36;width=w-2*m;buffer=io.BytesIO();c=Canvas(buffer,pagesize=A4);layout=[]
 def para(text,top,size=10.5,bold=False,color='#344258',x=m,span=width):
  p=Paragraph(text,ParagraphStyle('d',fontName='DepthBold' if bold else 'Depth',fontSize=size,leading=size*1.4,textColor=HexColor(color)))
  _,ph=p.wrap(span,1000);p.drawOn(c,x,top-ph);return top-ph
 def illustration(spec,top,figure_height=235):
  # PDF encoding only: preserve source PNGs; avoid embedding huge hidden raster regions.
  def encoded_image(path):
   from PIL import Image
   data=io.BytesIO();Image.open(path).convert('RGB').save(data,format='JPEG',quality=92,optimize=True);data.seek(0);return ImageReader(data)
  if spec in ('diversity','senses-olfaction'):
   image=encoded_image(ROOT/('assets/summary-art/sangre-generativa.png' if spec=='diversity' else 'assets/summary-art/sentidos-generativa.png'));iw,ih=image.getSize();x0,x1=(.508,1) if spec=='diversity' else (0,.492);y0,y1=(.393,.577) if spec=='diversity' else (.383,.576);scale=min(210/((x1-x0)*iw),140/((y1-y0)*ih));fw,fh=(x1-x0)*iw*scale,(y1-y0)*ih*scale;fx=m+(width-fw)/2;fy=top-fh
   c.saveState();path=c.beginPath();path.rect(fx,fy,fw,fh);c.clipPath(path,stroke=0);c.drawImage(image,fx-x0*iw*scale,fy-(1-y1)*ih*scale,width=iw*scale,height=ih*scale,mask='auto');c.restoreState();return top-fh-8
  image=encoded_image(ROOT/'api/_mindmaps'/spec);iw,ih=image.getSize();fh=figure_height;fw=fh*iw/ih;c.drawImage(image,m+(width-fw)/2,top-fh,width=fw,height=fh,mask='auto');return top-fh-8
 for index,page in enumerate(page_specs):
  c.setFillColor(HexColor(accent));c.rect(0,h-6,w,6,fill=1,stroke=0)
  c.drawImage(str(ROOT/'promo-ben-carson-tiktok/public/authentic/logo.png'),m,h-78,width=58,height=58,mask='auto')
  para('PREPARATORIA BEN CARSON',h-29,11,True,'#18263f',m+68,330)
  para('ALCOCERMED · MORFOFUNCIÓN · AMPLIACIÓN DEL RESUMEN',h-49,8,False,accent,m+68,410)
  c.setStrokeColor(HexColor('#dfe7ed'));c.line(m,h-87,w-m,h-87)
  top=para(escape(page['title']),h-104,21,True,'#18263f')-10
  top=illustration(page['figure'],top,page.get('figure_height',235))
  top=para(escape(page['caption']),top,8.3,False,'#60718a')-12
  for block_title,text in page['blocks']:
   top=para(escape(block_title),top,11,True,accent)-4
   top=para(escape(text),top,10.3)-10
  assert top>=87,('Overflow',index,top)
  layout.append({'page':15+index,'bottom':round(top,2)})
  para('Fuente: '+escape(page['source']),70,7.2,False,'#60718a')
  c.line(m,42,w-m,42)
  para('Ilustración generada con IA · texto original seleccionable · revisión docente pendiente',32,6.8,False,'#60718a')
  para(f'{15+index:02d} / {total}',32,8,True,accent,w-m-44,44)
  c.showPage()
 c.save();extra=PdfReader(io.BytesIO(buffer.getvalue()));writer=PdfWriter()
 for page in list(base.pages)[:14]+list(extra.pages):writer.add_page(page)
 writer.add_metadata({'/Title':title+' · Resumen ilustrado ampliado','/Author':'Preparatoria Ben Carson','/Subject':'Síntesis original basada en Saladin; ampliación de mecanismos y casos razonados.'})
 with open(target,'wb') as f:writer.write(f)
 out=ROOT/'output/pdf'/target.name;out.parent.mkdir(parents=True,exist_ok=True);out.write_bytes(target.read_bytes())
 qa=ROOT/('output/morfo-sangre-sentidos/pdf-erythroid-qa' if slug=='sangre' else 'output/morfo-sangre-sentidos/pdf-sentidos-depth-qa');qa.mkdir(parents=True,exist_ok=True);(qa/'layout.json').write_text(json.dumps(layout,indent=2),encoding='utf8')
 print(json.dumps({'pages':len(writer.pages),'bytes':target.stat().st_size,'layout':layout}))
if __name__=='__main__':extend()
