"""Protected synthesis of factor defects, inheritance and mechanistic comparisons."""
from pathlib import Path
import json
ROOT=Path(__file__).resolve().parents[3]
ID='morfo_18_sangre__12'
GENEA='https://www.ncbi.nlm.nih.gov/books/NBK1404/'
GENEB='https://www.ncbi.nlm.nih.gov/books/NBK1495/'
WOMEN='https://www.cdc.gov/hemophilia/about/information-for-women.html'
COFACTOR='https://pubmed.ncbi.nlm.nih.gov/3920653/'
CELL='https://pubmed.ncbi.nlm.nih.gov/7655009/'
INHERIT='https://www.cdc.gov/hemophilia/testing/how-hemophilia-is-inherited.html'
ROWS=[
 ('Identificar el defecto antes de seguir flechas',[
  ('A: actividad insuficiente del factor VIII','La hemofilia A se relaciona con deficiencia funcional del factor VIII. No debe confundirse VIII con el fibrinógeno que forma la red ni con las plaquetas del tapón inicial. Identificar el componente permite ubicar la alteración antes de predecir su consecuencia. El nombre A no significa que toda proteína o toda etapa de coagulación esté ausente.',736),
  ('B: actividad insuficiente del factor IX','La hemofilia B se relaciona con deficiencia del factor IX. Aunque A y B pueden producir manifestaciones hemorrágicas parecidas, no son nombres intercambiables de un mismo defecto. Cambia el componente implicado; por ello, un parecido en la manifestación no identifica por sí solo qué factor presenta actividad insuficiente. La comparación debe conservar la identidad del factor, no solo la letra de la enfermedad.',736),
  ('C: factor XI y un patrón hereditario distinto','El capítulo denomina hemofilia C a la deficiencia de factor XI y la distingue de A y B por su herencia autosómica. En el esquema clásico, XIa participa en activar IX. No debe sustituirse XI por VIII o IX en la definición de C ni deducirse una herencia ligada al X solo porque los tres cuadros compartan el término hemofilia.',736)]),
 ('Relacionar el componente con la reacción',[
  ('Proteasa y cofactor trabajan juntos','IXa actúa con VIIIa como cofactor para activar X a Xa. En A se altera el cofactor; en B, la proteasa. Son componentes diferentes de una asociación funcional. [Precisión bioquímica: PMID 3920653.]',735),
  ('Una misma reacción puede fallar por componentes distintos','Conservar IX no garantiza actividad normal del conjunto si VIII es insuficiente, y conservar VIII no garantiza normalidad si se altera IX. Esta comparación explica por qué una reacción depende de la cooperación de sus componentes. No significa que los factores se transformen unos en otros ni que añadir cualquier proteína faltante corrija cualquier defecto: la función específica importa.',735),
  ('Inicio y propagación no son equivalentes','La actividad iniciada por factor tisular no vuelve innecesaria la contribución del complejo IXa/VIIIa a la generación de Xa y trombina. La evidencia celular distingue ubicación y función de los componentes. Así, inicio conservado no prueba propagación normal ni obliga a afirmar ausencia absoluta de todo producto. [Complemento experimental: PMID 7655009.]',734)]),
 ('Herencia ligada al X sin reglas absolutas falsas',[
  ('Seguir el cromosoma que transmite el padre','En el modelo cromosómico XX/XY, un padre transmite su X a sus hijas y su Y a sus hijos. Para una variante de F8 situada en su X, la transmisión paterna directa es a las hijas, no de padre a hijo varón. Heredar la variante y presentar un grado concreto de sangrado son preguntas distintas. [Precisión: GeneReviews, hemofilia A.]',736),
  ('Antecedentes familiares y variantes nuevas','La falta de antecedentes conocidos no excluye hemofilia hereditaria. Una variante puede aparecer de novo o estar presente en una familia sin haber sido reconocida. Para A y B, los genes implicados son F8 y F9, respectivamente. No basta que una historia familiar parezca negativa para convertir automáticamente un defecto congénito de factor en una alteración plaquetaria. [Precisión: GeneReviews A y B.]',736),
  ('Las mujeres también pueden presentar sangrado','Las mujeres con una variante relacionada con hemofilia pueden tener manifestaciones hemorrágicas; no deben considerarse necesariamente portadoras asintomáticas. Predominio en varones no significa exclusividad masculina. Esta precisión corrige una lectura demasiado rígida de la herencia recesiva ligada al X. [Actualización: CDC, hemofilia en mujeres.]',736)]),
 ('Del defecto de coagulación a la manifestación',[
  ('El sangrado no identifica por sí solo el factor','El capítulo describe hemorragias musculares y articulares asociadas a hemofilia. Esa manifestación informa sobre el problema hemostático y sus consecuencias, pero no permite distinguir A de B solamente por dónde ocurrió el sangrado. Hay que conservar la diferencia entre observar una consecuencia y conocer el componente responsable, sin transformar un síntoma en una identificación molecular automática.',736),
  ('Por qué importan los tejidos afectados','Una acumulación de sangre dentro de tejidos puede producir dolor y limitar la movilidad; en la articulación, el problema compromete el movimiento además de representar pérdida sanguínea. El vínculo causal no se resume en que hay sangre fuera del vaso: hay que relacionar localización, acumulación y función del tejido. El texto usa estas consecuencias para mostrar que la alteración no es solo un dato de laboratorio.',736),
  ('Actividad residual y variabilidad','El capítulo señala que la gravedad puede variar y que no toda deficiencia implica ausencia completa de actividad. Conviene preguntar cuánto funcionamiento se conserva, en lugar de imaginar un interruptor idéntico en todos los casos. Este principio no permite predecir por sí solo la evolución individual ni extrapolar un porcentaje histórico del libro a cualquier persona o situación.',736)]),
 ('Distinguir factor, plaqueta y disponibilidad de vitamina',[
  ('Plaquetas conservadas, factor alterado','Una alteración de un factor de coagulación no exige que el número de plaquetas esté disminuido. El tapón plaquetario y el refuerzo por fibrina son tareas relacionadas, pero evaluar una no describe toda la otra. En el modelo de hemofilia, conservar el recuento no elimina el defecto funcional del factor; tampoco demuestra que cada aspecto de la función plaquetaria sea normal.',732),
  ('Hemofilia B no es sinónimo de falta de vitamina K','El factor IX pertenece al grupo relacionado con vitamina K, pero una deficiencia hereditaria de IX no equivale a menor absorción intestinal de esa vitamina. En el primer caso se estudia un componente específico; en el segundo cambia la disponibilidad de un requisito compartido por varios factores. Compartir una proteína afectada no vuelve idénticos los mecanismos que la alteran.',736),
  ('No confundir un defecto específico con síntesis hepática global','La función hepática condiciona la producción de gran parte de los factores. Una alteración de síntesis puede afectar a varios componentes; identificar un defecto hereditario concreto exige otro nivel de explicación. En una comparación hay que decir si se modifica la capacidad global de producción o la función de un componente determinado, en lugar de llamar hemofilia a toda coagulación insuficiente.',736)]),
 ('Aplicar el razonamiento con controles explícitos',[
  ('Comparar preparaciones que cambian un solo componente','Si dos modelos mantienen superficies y demás componentes, pero uno reduce VIII y otro reduce IX, ambos pueden alterar la reacción compartida por razones diferentes. La predicción útil nombra qué función falta en cada uno. No basta decir que los dos coagulan menos: hay que explicar qué dato permitiría distinguirlos y qué variable se mantuvo constante para comparar.',735),
  ('No diagnosticar a partir de una sola observación','Un sangrado, un recuento plaquetario o una historia familiar aislados no describen todos los mecanismos de hemostasia. Los ejercicios de este mapa identifican explícitamente el factor alterado o las variables del modelo para practicar relaciones causales. Sus respuestas no constituyen un diagnóstico individual ni permiten escoger un producto o una dosis de tratamiento.',736),
  ('Reconstruir desde el factor hasta la red','Parte del componente específico, localiza su función y sigue cómo se relaciona con activación de X, generación de trombina y formación de fibrina. Después separa las consecuencias tisulares y la herencia. Este recorrido evita memorizar A, B y C como tres etiquetas sin conexión con el mecanismo y conserva la diferencia entre defecto, reacción, manifestación y transmisión.',735)])]
PROMPTS=[(0,0,'¿Qué identifica hemofilia A y qué no implica la letra A?'),(0,1,'¿Por qué una manifestación parecida no vuelve idénticas A y B?'),(0,2,'¿Qué dos distinciones necesitas para no confundir C con A o B?'),(1,1,'¿Por qué conservar un componente no garantiza normalidad de la reacción compartida?'),(3,0,'¿Por qué la localización de un sangrado no distingue por sí sola A de B?'),(3,1,'Relaciona acumulación de sangre, localización y pérdida de función tisular.'),(3,2,'¿Por qué una deficiencia de factor no siempre equivale a actividad cero?'),(4,0,'¿Qué permite y qué no permite inferir un recuento plaquetario conservado?'),(4,1,'Distingue deficiencia hereditaria de IX y menor disponibilidad de vitamina K.'),(4,2,'Distingue un defecto específico de factor y una alteración de síntesis hepática.')]
QUESTIONS=[
 ('En dos modelos se conservan las superficies y los demás componentes: A reduce VIII; B reduce IX. ¿Qué comparación ubica correctamente el defecto?',[
 'A afecta al cofactor y B a la proteasa del conjunto que contribuye a activar X','A afecta al sustrato X y B al cofactor VIIIa','Ambos modelos alteran únicamente la cantidad de plaquetas','A y B son el mismo defecto porque pueden reducir una reacción compartida'],0,[
 'Correcto: distingue funciones de VIIIa e IXa sin confundir una salida compartida con identidad de componente.',
 'Intercambia las identidades del caso: no se modifica X en A ni se define IXa como el cofactor VIIIa en B.',
 'El ejercicio modifica factores específicos y conserva los demás componentes; no establece un cambio del recuento.',
 'Una misma salida puede alterarse por fallos diferentes; el parecido funcional no borra el componente afectado.'],[735,736],'Distinguir componentes del complejo y una salida compartida.'),
 ('Un padre tiene una variante de F8 en su cromosoma X. En el modelo XX/XY, ¿qué transmisión paterna directa corresponde?',[
 'Su X con la variante pasa necesariamente a sus hijos varones','Su X con la variante se transmite a sus hijas, mientras los hijos reciben su Y','El padre no puede transmitir ninguna variante de F8 a su descendencia','Todas las hijas que reciben la variante tendrán exactamente el mismo sangrado'],1,[
 'En ese modelo, los hijos varones reciben el Y paterno; confunde el cromosoma transmitido por el padre.',
 'Correcto: sigue el cromosoma paterno y separa transmisión genética de manifestación clínica individual.',
 'Excluye sin fundamento la transmisión a hijas; F8 se localiza en el X y puede seguir ese recorrido paterno.',
 'Recibir la variante no demuestra un fenotipo hemorrágico idéntico en todas las hijas; son preguntas distintas.'],[736],'Seguir el X paterno sin equiparar transmisión y expresión clínica.'),
 ('Una estudiante afirma: «Si es mujer, solo puede ser portadora sin sangrado». ¿Qué corrección está sustentada?',[
 'Las mujeres no transmiten variantes ligadas al X cuando tienen síntomas','El predominio en varones excluye toda manifestación hemorrágica en mujeres','Las mujeres también pueden presentar sangrado; portadora no equivale siempre a asintomática','Presentar sangrado demuestra que toda mujer tiene hemofilia C'],2,[
 'Tener o no manifestaciones no elimina por definición la posibilidad de transmitir una variante genética.',
 'Convierte predominio estadístico en exclusividad y reproduce precisamente la simplificación que se corrige.',
 'Correcto: reconoce la posibilidad descrita por CDC sin atribuir un diagnóstico concreto a una persona.',
 'El sexo y una manifestación aislada no identifican un factor XI alterado ni excluyen otros mecanismos.'],[736],'Corregir una regla absoluta de herencia y expresión clínica.'),
 ('Un caso define deficiencia hereditaria de XI. ¿Qué inferencia evita transferir sin más el patrón de A y B?',[
 'La letra C significa que el factor alterado es IX en lugar de XI','Todos los cuadros llamados hemofilia deben estar ligados al X','La deficiencia de XI demuestra ausencia completa de fibrinógeno','La clasificación C del capítulo es autosómica; compartir el nombre no iguala la herencia'],3,[
 'Contradice el componente definido en el caso y confunde la identidad de C con la de hemofilia B.',
 'Generaliza el patrón de A y B a una entidad que el propio capítulo distingue como autosómica.',
 'Un defecto de XI no demuestra que el sustrato fibrinógeno esté ausente; cambia el eslabón sin evidencia.',
 'Correcto: conserva el factor XI y el patrón descrito, sin convertir una etiqueta común en mecanismo único.'],[735,736],'Separar nombre de familia, factor y patrón hereditario.'),
 ('Se identifica una deficiencia hereditaria de IX y un recuento plaquetario conservado. ¿Qué afirmación mantiene separados los datos?',[
 'El recuento conservado no elimina el defecto del factor ni demuestra una falta de vitamina K','Toda cifra plaquetaria conservada excluye una alteración de generación de fibrina','Cualquier deficiencia de IX demuestra necesariamente obstrucción de la vía biliar','El factor IX puede sustituirse conceptualmente por una cifra de plaquetas'],0,[
 'Correcto: no usa la cifra celular como prueba de todos los factores ni confunde etiologías diferentes de IX.',
 'La cifra informa de un componente celular; no garantiza normalidad de cada reacción de coagulación.',
 'El caso define una alteración hereditaria específica, no demuestra un bloqueo de absorción por falta de bilis.',
 'Identidad y función de un factor no son una medición celular; sustituirlos elimina el mecanismo del caso.'],[732,736],'Integrar factor específico y dato celular sin confundir causas.'),
 ('Un modelo de hemofilia conserva algo de actividad del factor y muestra menor generación de producto que el control. ¿Qué lectura respeta el resultado?',[
 'Toda deficiencia obliga a que la actividad y el producto sean exactamente cero','La deficiencia puede ser parcial; debe distinguirse actividad residual de función completamente conservada','Si existe producto, el factor estudiado no puede tener ninguna contribución','El resultado identifica por sí solo la gravedad clínica de toda persona con ese defecto'],1,[
 'Reduce una variable funcional graduada a un interruptor y contradice la actividad residual definida.',
 'Correcto: conserva la diferencia respecto al control sin inventar ausencia absoluta ni normalidad completa.',
 'La presencia de algún producto no elimina la contribución del componente ni explica la reducción observada.',
 'Un resultado de un modelo no establece por sí solo la evolución o gravedad individual de una enfermedad.'],[735,736],'Interpretar una alteración parcial con control, sin extrapolar gravedad individual.')]

def main():
 refs=[{'url':INHERIT,'scope':'Recorrido del X paterno hacia hijas y separación de variante y manifestación.'},{'url':COFACTOR,'scope':'VIIIa como cofactor de IXa para activar X.'},{'url':CELL,'scope':'Inicio y propagación celular no equivalen a vías independientes.'},{'url':GENEA,'scope':'F8, transmisión paterna del X y variantes de novo.'},{'url':GENEB,'scope':'F9 y posibilidad de variantes nuevas.'},{'url':WOMEN,'scope':'Mujeres con hemofilia y sangrado, frente a regla absoluta de portadoras asintomáticas.'}]
 sections=[{'title':title,'groups':[{'title':'Defecto, mecanismo y comparación','items':[{'title':t,'text':text,'source':{'book':'Saladin: Anatomía y fisiología','chapter':18,'pdfPage':p,'kind':'original_synthesis','supplementaryReferences':([COFACTOR] if s==1 and i==0 else [CELL] if s==1 and i==2 else [GENEA,INHERIT] if s==2 and i==0 else [GENEA,GENEB] if s==2 and i==1 else [WOMEN] if s==2 and i==2 else [])}} for i,(t,text,p) in enumerate(rows)]}]} for s,(title,rows) in enumerate(ROWS)]
 practice={'flashcards':[{'question':q,'answer':ROWS[s][1][i][1],'pdf_pages':[ROWS[s][1][i][2]]} for s,i,q in PROMPTS],'questions':[{'question':q,'options':o,'correct':c,'reasons':r,'pdf_pages':pages,'difficulty':'medio','difficulty_reason':why} for q,o,c,r,pages,why in QUESTIONS],'source':'Saladin, cap. 18 · PDF 732–736 (libro 704–708). Precisiones de complejos, herencia y expresión en mujeres señaladas por separado.','supplementary_reference':' · '.join([COFACTOR,CELL,GENEA,GENEB,WOMEN,INHERIT]),'review':'Segunda revisión automatizada; revisión docente pendiente.'}
 title='Hemofilias A, B y C: factores, mecanismo y herencia'
 payload={'id':ID,'title':title,'topic':'Sangre','sections':sections,'assets':{'image':'/assets/mindmaps/illustrations/morfo_18_sangre.webp','alt':'Comparación de VIII, IX y XI, función del complejo y herencia de hemofilias','download':'/api/mindmap?id='+ID+'&format=image','filename':ID+'-Ben-Carson.webp','source':{'book':'Saladin: Anatomía y fisiología','chapter':18,'pdfPages':[732,734,735,736],'kind':'original_synthesis'},'generative_download':True,'practice':practice},'review':{'state':'automated_review_passed','doctor_approved':False,'scope':'Hemofilias hereditarias, relaciones fisiológicas y límites de inferencia. Sin diagnósticos individuales, umbrales de gravedad ni tratamiento. Hemofilia adquirida y estudio de laboratorio quedan pendientes.'},'supplementary_references':refs}
 (ROOT/'api/_mindmaps'/(ID+'.json')).write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 meta={'id':ID,'titulo':title,'root_title':title,'materia':'Morfofunción','tema':'Sangre','parent_key':'morfo_18_sangre.png','url_imagen':'premium/'+ID+'.json','descripcion':'Compara VIII, IX y XI, defecto de factor frente a plaquetas, actividad residual y transmisión ligada al X. Casos razonados.','premium':True,'acceso_gratis':False,'curated':True,'preview':'/assets/mindmaps/premium-previews/'+ID+'.webp'}
 for file in ['mindmaps-curated-additions.json','mindmaps-premium-catalog.json']:
  p=ROOT/'content'/file;rows=[r for r in json.loads(p.read_text(encoding='utf8')) if r['id']!=ID]+[meta];p.write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 rows=json.loads((ROOT/'content/mindmaps-premium-catalog.json').read_text(encoding='utf8'));(ROOT/'mindmap-premium-catalog.js').write_text('/* Public metadata only. Full explanations and downloads require verified access. */\nwindow.MINDMAP_PREMIUM_CATALOG = '+json.dumps(rows,ensure_ascii=False,separators=(',',':'))+';\n',encoding='utf8')
 print('Hemofilias: 18 explanations, 10 cards, 6 reasoned questions.')
if __name__=='__main__':main()
