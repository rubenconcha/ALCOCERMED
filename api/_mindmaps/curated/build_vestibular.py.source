"""Original vestibular synthesis. Protected source, no database mutations."""
from pathlib import Path
import json
ROOT=Path(__file__).resolve().parents[3]
ID='morfo_16_organos_sentidos__09'
ROWS=[
 ('Elegir el receptor según el estímulo',[
  ('Orientación, traslación y rotación son preguntas distintas','El aparato vestibular aporta información sobre fuerzas y movimientos de la cabeza, pero no mediante un receptor único. Utrículo y sáculo participan en la detección de gravedad y aceleración lineal; los conductos semicirculares responden a la dinámica de la rotación. Antes de nombrar una estructura conviene especificar qué cambia en el ejemplo: orientación, velocidad lineal o giro.',633),
  ('Acelerar no significa solamente moverse rápido','Aceleración es cambio de velocidad, que puede incluir cambio de magnitud o dirección. Arrancar y frenar en línea recta son estímulos distintos de mantener una velocidad rectilínea uniforme. Iniciar un giro tampoco equivale a sostener indefinidamente la misma rotación: la respuesta vestibular depende del tiempo y de la mecánica del receptor.',633),
  ('El equilibrio combina más de una fuente','Las señales vestibulares se integran con visión y propiocepción, incluidas señales del cuello. Esto permite relacionar movimientos de la cabeza con postura corporal y entorno. Una señal aislada no constituye una descripción completa de la posición del cuerpo ni autoriza a identificar una causa clínica de desequilibrio.',634)]),
 ('Máculas: membrana otolítica y gravedad',[
  ('Utrículo y sáculo tienen máculas','Cada mácula contiene células pilosas y de soporte. Con la cabeza erguida, la utricular se dispone aproximadamente horizontal y la sacular aproximadamente vertical. Estas orientaciones favorecen sensibilidades a componentes diferentes del estímulo; no implican que cada órgano funcione de forma aislada en toda postura de la cabeza.',633),
  ('Las otoconias aportan masa e inercia','Los cristales asociados a la membrana otolítica aumentan su masa y permiten que gravedad e inercia produzcan desplazamiento relativo respecto del epitelio. Esa deformación flexiona los haces. Las otoconias no son neurotransmisores ni fibras nerviosas, y no deben trasladarse al interior de la cúpula normal del conducto semicircular.',633),
  ('Inclinación y aceleración lineal requieren integración','La gravedad al inclinar la cabeza y las fuerzas de una aceleración lineal pueden desplazar la membrana otolítica. La señal periférica aislada no separa inequívocamente todos esos contextos. El encéfalo integra otras señales para interpretar la situación; esta precisión amplía el esquema del libro y evita atribuir a una mácula una lectura independiente y absoluta del movimiento.',634)]),
 ('Conductos: endolinfa, ampolla y cúpula',[
  ('Tres planos amplían la información de rotación','Los tres conductos de cada lado se orientan en planos diferentes. Sus respuestas, junto con las del lado contrario, contribuyen a representar giros en el espacio. No basta decir que todos detectan cualquier movimiento por igual: la orientación y la comparación de señales importan para interpretar qué componente de rotación está ocurriendo.',636),
  ('La cresta está en la ampolla','La ampolla es una dilatación del conducto que contiene la cresta ampollar. Las células receptoras se relacionan con la cúpula gelatinosa, que se deforma por movimientos relativos de la endolinfa. Cresta y cúpula no son sinónimos: una es el epitelio sensorial y la otra es la estructura que transmite la deformación al haz.',636),
  ('Inercia al iniciar y detener un giro','Al iniciar la rotación, el conducto y la endolinfa no cambian su movimiento de forma idéntica; esa diferencia puede deformar la cúpula. Tras una rotación mantenida, el desplazamiento relativo disminuye y la respuesta se adapta. Detenerse puede producir una deformación transitoria opuesta. No se debe explicar el proceso como un flujo continuo que crece sin límite mientras gira la cabeza.',636)]),
 ('De la flexión a la señal vestibular',[
  ('Cinetocilio y polaridad del haz','Las células pilosas vestibulares tienen un cinetocilio que permite definir la polaridad funcional del haz. Desviar hacia él y desviar en sentido contrario no son estímulos equivalentes. Esta referencia distingue el haz vestibular del esquema de una célula coclear madura y ayuda a evitar aplicar exactamente el mismo dibujo a ambos sistemas.',633),
  ('La respuesta puede aumentar o disminuir','Una flexión hacia el cinetocilio favorece despolarización y aumento de señal aferente; una flexión opuesta produce el cambio contrario. Existen descargas basales, por lo que un movimiento puede codificarse mediante aumentos o disminuciones, no únicamente como encendido desde cero. El detalle de polaridad y descarga basal se contrasta con la referencia fisiológica complementaria.',636),
  ('Receptor y neurona siguen siendo distintos','Las células pilosas establecen sinapsis con fibras del nervio vestibular. El potencial receptor graduado modifica la liberación sináptica, y la neurona aferente transmite la señal mediante potenciales de acción. El nervio vestibular y el coclear se reúnen en el par VIII, pero reciben información de receptores con funciones diferentes.',637)]),
 ('Usar la señal para mirar y sostenerse',[
  ('Reflejo vestibuloocular: compensar la cabeza','Las conexiones vestibulares con núcleos motores oculares ayudan a generar movimientos de ojos compensadores de los de la cabeza. En un giro horizontal sencillo, ojos y cabeza se desplazan en sentidos opuestos para estabilizar la imagen del objetivo. El reflejo no significa que el objeto externo se mueva ni depende exclusivamente de la percepción consciente.',637),
  ('Postura y cerebelo: integrar y ajustar','Las proyecciones vestibulares participan en ajustes de postura mediante conexiones espinales y en coordinación a través del cerebelo. No constituyen una orden directa única para todos los músculos: se integran con otras entradas y circuitos. La función de equilibrio incluye estabilizar mirada y cuerpo, además de percibir la orientación.',637),
  ('Un esquema no es una prueba diagnóstica','Los ejemplos comparan mecanismos normales de receptores y circuitos. Una sensación de giro o inestabilidad no permite deducir por sí sola un receptor dañado ni escoger una maniobra o tratamiento. La interpretación clínica exige información adicional; este mapa no transforma ejercicios de fisiología en diagnósticos individuales.',637)]),
 ('Casos para distinguir mecanismos',[
  ('Caso: el automóvil arranca y luego frena','En ambos momentos cambia la velocidad lineal y la inercia puede desplazar la membrana otolítica respecto del epitelio. El sentido del desplazamiento cambia entre fases. Responder únicamente que actúan los conductos por existir movimiento omite la diferencia entre traslación lineal y rotación.',634),
  ('Caso: elevador con cabeza erguida','Los cambios de movimiento vertical permiten relacionar la orientación de la mácula sacular con componentes verticales de la aceleración. El ejemplo no significa que el sáculo mida por sí solo el piso alcanzado o la altura absoluta. Una fase de desplazamiento uniforme no equivale a una aceleración vertical mantenida.',635),
  ('Caso: silla que gira de forma sostenida','Al comienzo y al detener el giro cambian las relaciones entre endolinfa, conducto y cúpula. Durante una rotación mantenida, el sistema puede adaptar su respuesta. La explicación correcta distingue fases del movimiento; no concluye que toda actividad vestibular desaparece ni que cualquier sensación posterior demuestre enfermedad.',636)])]

PROMPTS=[
 (0,0,'¿Qué distinción orienta la elección entre órganos otolíticos y conductos semicirculares?'),
 (0,1,'¿Por qué arrancar y avanzar a velocidad uniforme no son estímulos equivalentes?'),
 (1,0,'Compara la orientación de las máculas con la cabeza erguida.'),
 (1,1,'¿Cómo contribuyen las otoconias al funcionamiento de la mácula?'),
 (1,2,'¿Por qué una señal otolítica aislada no resuelve toda distinción entre inclinación y traslación?'),
 (2,1,'Distingue ampolla, cresta ampollar y cúpula.'),
 (2,2,'Reconstruye el papel de la inercia al iniciar y detener una rotación.'),
 (3,1,'¿Por qué una respuesta vestibular puede aumentar o disminuir respecto de un nivel basal?'),
 (3,2,'Distingue la respuesta de la célula pilosa de la señal en el nervio vestibular.'),
 (4,0,'¿Qué relación entre ojos y cabeza explica un reflejo vestibuloocular horizontal sencillo?')]

QUESTIONS=[
 ('Una persona mantiene la cabeza erguida mientras un elevador empieza a subir. ¿Qué relación explica mejor el componente vertical del estímulo?', ['Orientación de la mácula sacular e inercia de su membrana otolítica','Cristales de la cúpula que estimulan exclusivamente el conducto lateral','Vibración de la membrana basilar por el desplazamiento vertical','Movimiento de la ventana oval que mide la altura del elevador'],0,[
 'Correcto: la disposición aproximadamente vertical de la mácula sacular ayuda a relacionarla con la aceleración vertical del ejemplo.',
 'La cúpula normal no contiene otoconias y los conductos se relacionan con la dinámica de la rotación, no con esa explicación vertical.',
 'La membrana basilar pertenece al mecanismo coclear de audición; no explica la respuesta otolítica a esta aceleración.',
 'La ventana oval transmite vibración al sistema coclear y no constituye un sensor de altura absoluta.'],[633,635]),
 ('¿Qué comparación conserva la diferencia entre mácula y cresta ampollar?', ['Ambas dependen de una cúpula que contiene cristales','La mácula se relaciona con membrana otolítica; la cresta con una cúpula sin otoconias','La cresta es una fibra nerviosa y la mácula un huesecillo','Solo la cresta contiene células receptoras'],1,[
 'Traslada indebidamente las otoconias a la cúpula y confunde las estructuras que transmiten el estímulo a cada epitelio.',
 'Correcto: distingue los dos conjuntos de estructura sensorial y cubierta mecánica sin intercambiar sus componentes.',
 'Ambas son estructuras sensoriales epiteliales; no equivalen a una fibra nerviosa ni a un huesecillo del oído medio.',
 'Las máculas también contienen células pilosas receptoras y células de soporte, por lo que esa exclusión es incorrecta.'],[633,636]),
 ('Durante un giro sostenido de velocidad aproximadamente constante, ¿qué error debe evitarse?', ['Distinguir el inicio del giro de su mantenimiento','Considerar que la diferencia de movimiento entre endolinfa y conducto puede disminuir','Suponer que la deformación de la cúpula crece indefinidamente mientras dure el giro','Comparar la respuesta al inicio con la respuesta al detenerse'],2,[
 'Distinguir fases temporales es necesario para explicar la mecánica y adaptación; no es el error solicitado.',
 'La reducción del desplazamiento relativo es compatible con la adaptación durante la rotación mantenida.',
 'Correcto: no se acumula una deformación ilimitada. Deben considerarse inercia, adaptación y cambios al detener el movimiento.',
 'Comparar ambas transiciones permite reconocer cambios de dirección de la deformación, sin implicar por sí solo una enfermedad.'],[636]),
 ('En una respuesta vestibuloocular horizontal compensadora, ¿qué relación mantiene la mirada sobre un objetivo estable?', ['Ojos inmóviles en la órbita mientras la cabeza gira','Ojos y cabeza siempre giran en el mismo sentido','El objeto externo gira físicamente en sentido opuesto','Los ojos se desplazan en sentido compensador respecto de la cabeza'],3,[
 'Mantener los ojos fijos respecto de la cabeza no compensa el cambio de orientación de la cabeza respecto del objetivo.',
 'En el ejemplo sencillo, sumaría el desplazamiento en vez de proporcionar la compensación descrita.',
 'El reflejo actúa sobre músculos oculares; no requiere que el objeto externo se mueva para estabilizar la mirada.',
 'Correcto: las conexiones vestibulares con circuitos motores oculares contribuyen a ese movimiento compensador.'],[637]),
 ('¿Qué afirmación describe correctamente la polaridad de una célula pilosa vestibular?', ['Flexionar hacia el cinetocilio y en sentido contrario puede cambiar la señal en sentidos opuestos','Todo movimiento provoca exactamente la misma excitación','Solo puede codificar cambios porque nunca existe descarga aferente basal','El cinetocilio es una otoconia que entra al nervio'],0,[
 'Correcto: la dirección de flexión tiene significado funcional y puede aumentar o disminuir la respuesta respecto del nivel basal.',
 'Ignora la polaridad del haz y no permite explicar respuestas diferentes según dirección del estímulo.',
 'Existen descargas basales; el detalle fisiológico complementario permite entender aumentos y disminuciones alrededor de ellas.',
 'El cinetocilio es una estructura del haz apical, distinta de los cristales y de las fibras del nervio.'],[633,636]),
 ('Un automóvil arranca y luego mantiene velocidad rectilínea uniforme. ¿Qué interpretación distingue las fases?', ['La velocidad uniforme exige la misma aceleración lineal que el arranque','El arranque cambia velocidad; la fase uniforme no añade esa misma aceleración traslacional','Cualquier desplazamiento lineal es necesariamente una rotación de la cabeza','El utrículo mide de forma directa la distancia recorrida'],1,[
 'Confunde velocidad con su cambio. Mantener una velocidad rectilínea uniforme no exige esa aceleración.',
 'Correcto: distingue el cambio de velocidad inicial de la fase uniforme, conservando por separado los efectos de la gravedad.',
 'Traslación y rotación son componentes distintos; que ambos puedan coexistir no los convierte en equivalentes.',
 'La respuesta otolítica no proporciona por sí sola una lectura directa de distancia o posición absoluta del vehículo.'],[633,634])]

def main():
 sections=[{'title':title,'groups':[{'title':'Mecanismos y comparaciones','items':[{'title':t,'text':text,'source':{'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPage':p,'kind':'original_synthesis'}} for t,text,p in rows]}]} for title,rows in ROWS]
 cards=[{'question':q,'answer':ROWS[s][1][i][1],'pdf_pages':[ROWS[s][1][i][2]]} for s,i,q in PROMPTS]
 reference='https://www.ncbi.nlm.nih.gov/books/NBK11135/'
 practice={'flashcards':cards,'questions':[{'question':q,'options':o,'correct':c,'reasons':r,'pdf_pages':p} for q,o,c,r,p in QUESTIONS],'source':'Saladin, capítulo 16 · PDF 633–637 (impresas 605–609). Polaridad y descarga basal: ampliación Neuroscience NBK11135; integración otolítica: PMID 9870961.','review':'Revisión automatizada de fuente y diseño; revisión docente pendiente.','supplementary_reference':reference}
 title='Equilibrio vestibular: receptores, movimiento e integración'
 payload={'id':ID,'title':title,'topic':'Órganos de los sentidos','sections':sections,'assets':{'image':'/assets/mindmaps/illustrations/morfo_16_organos_sentidos.webp','alt':'Ilustración de apoyo de los sentidos','download':'/api/mindmap?id='+ID+'&format=image','filename':ID+'-Ben-Carson.webp','source':{'book':'Saladin: Anatomía y fisiología','chapter':16,'pdfPages':[633,634,635,636,637],'kind':'original_synthesis'},'generative_download':True,'practice':practice},'review':{'state':'automated_review_passed','doctor_approved':False,'clinical_diagnosis_tool':False,'scope':'Fisiología vestibular normal. No maniobras, pruebas diagnósticas ni tratamiento.'},'supplementary_references':[{'url':reference,'scope':'Polaridad del haz y actividad basal; ampliación expresamente identificada.'},{'url':'https://pubmed.ncbi.nlm.nih.gov/9870961/','scope':'Integración para interpretar señales otolíticas ambiguas.'}]}
 (ROOT/'api/_mindmaps'/(ID+'.json')).write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 meta={'id':ID,'titulo':title,'root_title':title,'materia':'Morfofunción','tema':'Órganos de los sentidos','parent_key':'morfo_16_organos_sentidos.png','url_imagen':'premium/'+ID+'.json','descripcion':'Máculas, otoconias, cúpula, inercia, señal vestibular y mirada. Lámina ilustrada, casos y práctica.','premium':True,'acceso_gratis':False,'curated':True,'preview':'/assets/mindmaps/premium-previews/'+ID+'.webp'}
 for file in ['mindmaps-curated-additions.json','mindmaps-premium-catalog.json']:
  p=ROOT/'content'/file;rows=[r for r in json.loads(p.read_text(encoding='utf8')) if r['id']!=ID]+[meta];p.write_text(json.dumps(rows,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
 rows=json.loads((ROOT/'content/mindmaps-premium-catalog.json').read_text(encoding='utf8'));(ROOT/'mindmap-premium-catalog.js').write_text('/* Public metadata only. Full explanations and downloads require verified access. */\nwindow.MINDMAP_PREMIUM_CATALOG = '+json.dumps(rows,ensure_ascii=False,separators=(',',':'))+';\n',encoding='utf8')
 print('Vestibular map: 18 explanations, 10 flashcards, 6 reasoned questions.')
if __name__=='__main__':main()
