"""Adapt supplied current partial papers; keep archival originals unchanged."""
from pathlib import Path
import json,hashlib
R=Path(__file__).resolve().parents[2]
chapters={
'first':[[10,2,5,8,11,7,1,10,7,5,6,7,5,8,8,10,10,2,2,2,9,5,2,7,6],[11,8,10,7,1,8,1,10,5,6,6,10,10,11,9,7,7,8,7,6,10,8,10,2,8],[6,2,2,1,2,1,2,2,2,2,3,6,2,2,2],[1,4,2,5,2,2,2,1,2,2,1,6,2,1,3],[1,3,1,1,1,1,1,1,3,1],[6,6,6,6,6,5,6,6,6,6]],
'second':[[13,17,16,12,18,16,19,16,17,18,20,15,16,13,16,14,18,13,12,13,17,16,18,18,14],[12,12,16,19,19,16,17,18,14,14,15,20,12,18,14,15,13,16,17,14,16,18,16,14,16],[8,11,8,8,12,9,7,11,8,9,9,8,11,7,8],[11,7,9,10,10,9,9,10,7,8,7,9,9,8,11],[7,10,7,7,7,11,7,12,7,11],[10,10,10,7,12,10,12,10,10,10]]}
for number,scope in enumerate(['first','second'],1):
 p=json.loads((R/'api/_past_exams'/f'2025-2026-{number}.json').read_text(encoding='utf8'));rows=p['questions'];assign={}
 for ns,cs,sub in [(list(range(1,26)),chapters[scope][0],'MORFOFUNCION'),(list(range(51,76)),chapters[scope][1],'MORFOFUNCION'),(list(range(26,41)),chapters[scope][2],'BIOLOGIA CELULAR'),(list(range(76,91)),chapters[scope][3],'BIOLOGIA CELULAR'),(list(range(41,51)),chapters[scope][4],'SALUD PUBLICA'),(list(range(91,101)),chapters[scope][5],'SALUD PUBLICA')]:
  assert len(ns)==len(cs)
  assign.update({n:{'subject':sub,'chapter':c} for n,c in zip(ns,cs)})
 for q in rows:
  digest=hashlib.sha256(json.dumps(q,sort_keys=True,ensure_ascii=False).encode()).hexdigest();q['coverage']=assign[q['numero_original']];q['source_question_id']=q['id'];q['source_sha256']=digest
 if scope=='first':
  # Historical q100 tests observational research designs, beyond the strict first-partial scope.
  rows[-1]={'id':'sim-first-theory-100','numero_original':100,'pregunta':'Una estudiante reúne antecedentes y conceptos pertinentes antes de analizar su problema de investigación. ¿Qué función cumple esta fundamentación teórica?','opcion_a':'Sustituye la formulación de objetivos por una lista de opiniones.','opcion_b':'Sitúa el problema en el conocimiento existente y orienta su análisis e interpretación.','opcion_c':'Permite interpretar los datos sin definir los conceptos utilizados.','opcion_d':'Garantiza que cualquier hipótesis propuesta resulte verdadera.','respuesta_correcta':'B','respuestas_aceptadas':['B'],'coverage':{'subject':'SALUD PUBLICA','chapter':6},'fuente':'Educación en Salud e Investigación CB24-25 · tema 6 · PDF 60–62','comentario':'Correcta B: el marco organiza antecedentes y conceptos para orientar el estudio. A elimina objetivos sin fundamento; C omite las definiciones que hacen posible el análisis; D convierte una propuesta contrastable en una verdad garantizada. Síntesis original del apartado leído.','source_question_id':None}
 if scope=='second':
  # Original q60 and q74 differ only in numbering punctuation; remove conceptual duplication in adapted model.
  rows[73]={'id':'sim-second-callosum-74','numero_original':74,'pregunta':'Una descripción confunde la estructura que separa los hemisferios cerebrales con la que los conecta mediante fibras. ¿Qué corrección corresponde?','opcion_a':'La cisura interhemisférica separa los hemisferios; el cuerpo calloso los conecta mediante fibras nerviosas.','opcion_b':'El cuerpo calloso es la ranura profunda que separa ambos hemisferios.','opcion_c':'La cisura interhemisférica es el haz de axones que comunica ambos hemisferios.','opcion_d':'El cuerpo calloso comunica exclusivamente el cerebelo con la médula espinal.','respuesta_correcta':'A','respuestas_aceptadas':['A'],'coverage':{'subject':'MORFOFUNCION','chapter':14},'fuente':'Saladin · capítulo 14 · PDF 542–543 (libro 514–515)','comentario':'Correcta A: distingue una cisura anatómica de un haz de fibras que conecta los hemisferios. B atribuye la separación al haz; C convierte la cisura en fibras; D cambia las estructuras comunicadas. Síntesis original del texto y figura 14.2.','source_question_id':None}
 out={'id':'partial-'+scope,'scope':scope,'title':'Simulacro '+str(number),'duration':100,'questions':rows,'review':{'type':'automated_scope_review','teacher_approved':False,'basis':'Human user confirmed Morfo 1–11 / 12–20 and Bio 1–6 / 7–12; final cumulative. Health follows stored cronograma SP01P1–SP06P1 / SP07P2–SP12P2. Each item classified by subject and chapter, not by year.','adaptations':['First partial historical question 100 on observational designs replaced with sourced theoretical-foundation item (Health topic 6).'] if scope=='first' else ['Second partial original questions 60 and 74 are conceptually duplicated; replace 74 with sourced chapter-14 comparison.'],'answer_accuracy':'Original accepted answer patterns retained; this scope review is not a new medical answer-key approval.'}}
 (R/'api/_simulations'/('partial-'+scope+'.json')).write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
cat={'entries':[{'key':'partial:first','curatedId':'partial-first','scope':'first','title':'Simulacro 1','type':'Primer parcial','minutes':100,'description':'Morfofunción 1–11 · Biología Celular 1–6 · Salud: temas 1–6. Modelo adaptado al temario.'},{'key':'partial:second','curatedId':'partial-second','scope':'second','title':'Simulacro 2','type':'Segundo parcial','minutes':100,'description':'Morfofunción 12–20 · Biología Celular 7–12 · Salud: temas 7–12. Modelo adaptado al temario, sin preguntas duplicadas.'}]}
archive=json.loads((R/'content/past-exams/catalog.json').read_text(encoding='utf8'))
for p in reversed(archive['exams']):
 if p['type']=='Examen final' and p['count']==100 and not p['missingNumbers'] and not p['excludedQuestions']:
  cat['entries'].append({'key':'real:'+p['id'],'pastId':p['id'],'scope':'final','type':'Examen final','title':'Simulacro '+str(len(cat['entries'])+1),'minutes':100,'free':p['year']==archive['freeYear'],'description':'Final acumulativo. Preguntas y clave del examen original; incluye contenidos de ambos parciales y del programa final.'})
cat['entries'] += [{'key':'full','scope':'final','type':'Examen final','title':'Simulacro 7','minutes':100,'demo':True,'description':'Final acumulativo de práctica · acceso abierto · reparto 50 / 30 / 20.'},{'key':'premium-full','scope':'final','type':'Examen final','title':'Simulacro 8','minutes':100,'description':'Final acumulativo del banco bibliográfico · selección por asignatura · reparto 50 / 30 / 20.'}]
(R/'content/simulacros-catalog.json').write_text(json.dumps(cat,ensure_ascii=False,indent=2)+'\n',encoding='utf8')
