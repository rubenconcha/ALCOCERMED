"""Build the requested 15+15+20 practice from the user's two official PDFs.
Usage: python api/_simulations/build_mini_foundations.py.source <referencias-oficiales>
Paid questions and this authoring source are protected by the simulation API rewrite.
"""
import hashlib
import json
import sys
from collections import Counter
from pathlib import Path

import pymupdf

ROOT = Path(__file__).resolve().parents[2]
STORE = ROOT / 'api/_simulations'
AUDIT = ROOT / 'quality/mini-foundations-audit.json'
sys.path.insert(0, str(ROOT))
from tools.suficiencia.build_medicine import assertion_question, compact


def read(path):
    return json.loads(path.read_text(encoding='utf-8-sig'))


def write(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n', encoding='utf-8', newline='\n')


def load_sources(refs, audit):
    manifest = {row['archivo']: row for row in read(refs / 'manifest.json')['archivos']}
    sources = {}
    for name, digest in audit['official_files'].items():
        file = refs / name
        with file.open('rb') as stream:
            sha = hashlib.file_digest(stream, 'sha256').hexdigest()
        if sha != digest or sha != manifest[name]['sha256']:
            raise ValueError(f'Huella de la fuente no coincide: {name}')
        doc = pymupdf.open(file)
        if len(doc) != manifest[name]['paginas_pdf']:
            raise ValueError(f'Cantidad de páginas inválida: {name}')
        sources[name] = doc
    return sources


def build(refs):
    audit = read(AUDIT)
    sources = load_sources(refs, audit)
    pairs = []
    for line in (STORE / 'mini-foundations-afirmaciones.txt').read_text(encoding='utf-8').splitlines():
        if not line or line.startswith('#'):
            continue
        number, first, why_first, second, why_second = [field.strip() for field in line.split('|')]
        if int(number) != len(pairs) + 1 or any(v[:2] not in {'+ ', '- '} for v in [first, second]):
            raise ValueError(f'Afirmaciones inválidas: {number}')
        pairs.append([(first[2:], first[0] == '+', why_first), (second[2:], second[0] == '+', why_second)])

    questions = []
    for number, (entry, pair) in enumerate(zip(audit['items'], pairs, strict=True), start=1):
        source = entry['source']
        document = sources[source['file']]
        primary = source['evidence_page']
        if primary not in source['pdf_pages'] or compact(source['anchor']) not in compact(document[primary - 1].get_text()):
            raise ValueError(f'Evidencia sin verificar: {entry["id"]}')
        if any(not 1 <= page <= len(document) for page in source['pdf_pages']):
            raise ValueError(f'Página sin verificar: {entry["id"]}')
        biology = entry['id'].startswith('mini-bio-')
        chapter = source['chapter']
        subject = 'BIOLOGIA CELULAR' if biology else 'MORFOFUNCION'
        topic = 'Introducción a la biología celular' if biology else ('Temas principales de anatomía y fisiología' if chapter == 1 else 'El sistema óseo')
        title = 'Alfonso Calvo · Biología celular biomédica · Elsevier, 2015' if biology else 'Kenneth S. Saladin · Anatomía y fisiología. La unidad entre forma y función · 6.ª edición'
        printed = ', '.join(source['printed_pages'] or [])
        pages = ', '.join(map(str, source['pdf_pages']))
        locator = ('p. impresa ' + printed if printed else 'archivo electrónico repaginado') + ' · p. PDF ' + pages
        item = assertion_question(pair)
        key = 'ABCDE'[item['correct']]
        questions.append({
            'id': entry['id'], 'materia': subject, 'tema': topic, 'dificultad': 'dificil',
            'numero_original': number, 'numero_pregunta': number,
            'pregunta': item['text'], **{'opcion_' + letter: value for letter, value in zip('abcd', item['options'], strict=True)},
            'respuesta_correcta': key, 'respuestas_aceptadas': [key],
            'justificacion': item['explanation'], 'comentario': item['explanation'],
            'truth_values': item['truth_values'], 'comentarios_opciones': item['comentarios_opciones'],
            'fuente': f'{title} · cap. {chapter} · {source["section"]} · {locator}',
            'paginas_pdf': pages, 'pagina_impresa': printed or None, 'source': source,
            'coverage': {'subject': subject, 'chapter': chapter, 'curriculum': 'official-pdfs-2026-10-19'},
        })
    if len(questions) != 50 or len({q['pregunta'] for q in questions}) != 50:
        raise ValueError('El minisimulacro debe contener cincuenta preguntas distintas')
    paper = read(STORE / 'mini-foundations.json')
    paper['questions'] = questions
    paper['review']['source_authority'] = 'Las afirmaciones y la corrección se basan en las páginas citadas de los textos oficiales.'
    write(STORE / 'mini-foundations.json', paper)
    audit['answers'] = dict(Counter(q['respuesta_correcta'] for q in questions))
    write(AUDIT, audit)
    print('50 preguntas de afirmaciones con evidencia verificada en los PDF oficiales.')


if __name__ == '__main__':
    build(Path(sys.argv[1]).resolve())
