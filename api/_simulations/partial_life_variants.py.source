"""Situational Life items, anchored to concepts actually examined in 2025–2026.
Two practice contexts per blueprint; this is adaptation, not a new archival paper.
"""
def build(scope,variant,read,digest):
    context=['un colegio periurbano','una comunidad rural'][variant]
    n=[600,960][variant];sample=[60,120][variant];interval=n//sample
    first=[
      (1,41,'Se prepara un taller participativo para reconocer riesgos y mejorar hábitos. ¿Cómo se relaciona la educación en salud con la promoción?', ['Contribuye a la promoción mediante aprendizaje y participación.','Es incompatible con la participación de la comunidad.','Solo puede realizarse después de una enfermedad terminal.','Sustituye todas las políticas sobre determinantes de la salud.']),
      (1,41,'El equipo diseña sus actividades sin escuchar a quienes viven allí. ¿Qué cambio incorpora participación comunitaria?', ['Definir necesidades y acciones junto con la comunidad.','Reservar todas las decisiones a un expositor externo.','Excluir a quienes tienen menor escolaridad.','Reemplazar el diálogo por una lista de órdenes inmodificables.']),
      (3,42,'Una persona necesita atención especializada de alta complejidad. ¿Qué nivel corresponde a esa capacidad resolutiva?', ['Tercer nivel de atención.','Primer nivel por tratarse de alta complejidad.','Un taller escolar, que sustituye cualquier derivación.','La atención domiciliaria sin recursos especializados en todos los casos.']),
      (3,49,'Se organiza el ingreso habitual a la red pública y la atención de problemas frecuentes. ¿Qué nivel cumple la función de puerta de entrada?', ['El primer nivel de atención.','Exclusivamente el tercer nivel.','Únicamente una unidad de cuidados intensivos.','Exclusivamente un instituto de trasplantes.']),
      (1,43,'Un programa busca limitar secuelas de una enfermedad ya establecida mediante rehabilitación. ¿Qué prevención describe?', ['Terciaria.','Primaria, porque todavía no existe enfermedad.','Primordial, porque solo modifica condiciones previas a cualquier riesgo.','Ninguna: la prevención nunca actúa sobre secuelas.']),
      (1,44,'Se identifican factores de riesgo de una enfermedad concreta para reducir su aparición. ¿Qué enfoque se aplica?', ['Prevención orientada a riesgos de esa enfermedad.','Una estrategia que exige esperar a que aparezcan todas las secuelas.','Una actividad ajena a la prevención por considerar riesgos.','La eliminación del análisis de factores clínicos y ambientales.']),
      (1,45,'Se propone educación inclusiva y oportunidades de aprendizaje durante toda la vida. ¿Con qué objetivo se relaciona?', ['ODS 4.','ODS 5, definido como construcción de carreteras.','ODS 8, definido como protección exclusiva de océanos.','ODS 9, definido como eliminación del aprendizaje permanente.']),
      (1,46,'Un proyecto elimina barreras que impiden a mujeres y niñas participar en igualdad. ¿Qué objetivo aborda?', ['ODS 5: igualdad de género.','ODS 6: igualdad de género como único contenido.','ODS 7: igualdad de género como único contenido.','ODS 14: igualdad de género como único contenido.']),
      (1,47,'Un proyecto considera las brechas dentro del país y entre países. ¿Qué alcance tiene el ODS 10?', ['Reducir las desigualdades en ambos ámbitos.','Reducir únicamente diferencias entre barrios del mismo municipio.','Eliminar toda política sobre desigualdades entre países.','Sustituir la reducción de desigualdades por la expansión exclusiva del transporte.']),
      (1,48,'Se busca empleo pleno y productivo en condiciones de trabajo decente. ¿Qué ODS expresa esa finalidad?', ['ODS 8.','ODS 4, cuyo único fin sería empleo y trabajo decente.','ODS 9, cuyo único fin sería empleo y trabajo decente.','ODS 10, cuyo único fin sería empleo y trabajo decente.']),
      (1,50,'La propuesta combina infraestructura resiliente, innovación e industrialización inclusiva. ¿Qué objetivo integra esos componentes?', ['ODS 9.','ODS 4.','ODS 5.','ODS 6.']),
      (6,91,'Una investigadora propone una explicación que todavía debe contrastar con datos. ¿Cómo debe considerarla?', ['Como una hipótesis, provisional y susceptible de contraste.','Como una verdad absoluta por haber sido escrita.','Como el resultado final antes de recolectar datos.','Como una garantía de que los datos coincidirán con su opinión.']),
      (6,92,'Se detecta un vacío de conocimiento que requiere respuesta científica. ¿Qué justifica esto?', ['La formulación de un problema de investigación.','La aceptación automática de cualquier hipótesis.','La sustitución del problema por el monto del presupuesto.','La eliminación de los objetivos y las variables.']),
      (6,93,'Un mismo fenómeno se estudia desde enfoques teóricos diferentes. ¿A qué se refiere el objeto formal?', ['Al abordaje o perspectiva teórica desde la que se estudia el objeto.','A la carpeta administrativa donde se archivan recibos.','Exclusivamente al tamaño físico del lugar de estudio.','Al nombre de la persona que firma el informe.']),
      (6,94,'Se plantea que una exposición causa un resultado. ¿Qué orden temporal es necesario para esa hipótesis causal?', ['La causa debe preceder al efecto.','El efecto debe ocurrir obligatoriamente antes de la causa.','La secuencia temporal es siempre irrelevante.','La causa y el efecto deben ser la misma variable.']),
      (6,95,'Una hipótesis relaciona la exposición de estudiantes con un resultado medible. ¿Qué elementos deben poder reconocerse?', ['Unidades de observación, variables y relación lógica.','Solo título, portada y número de páginas.','Únicamente el nombre del investigador y su cargo.','Solo presupuesto y cronograma, sin variables.']),
      (5,96,'La investigación termina y sus hallazgos deben comunicarse para aportar conocimiento. ¿Qué finalidad cumple el informe final?', ['Dar a conocer los resultados y sus conclusiones.','Mantener todos los resultados inaccesibles por definición.','Reemplazar los datos obtenidos por opiniones posteriores.','Demostrar que toda hipótesis inicial es verdadera.']),
      (6,97,'Una noción amplia se divide en dimensiones e indicadores observables. ¿Qué se está haciendo?', ['Operacionalizar el concepto para orientar su medición.','Suprimir toda definición de las variables.','Convertir cada indicador en una opinión imposible de observar.','Sustituir el marco conceptual por la portada del trabajo.']),
      (6,98,'El equipo debe precisar qué logrará y hasta dónde llegará el estudio. ¿Qué componente lo establece?', ['Los objetivos de investigación.','Exclusivamente el tipo de letra del informe.','La lista de gastos personales del investigador.','Una conclusión redactada sin datos ni objetivos previos.']),
      (6,92,'Hay presupuesto disponible, pero aún no se define una pregunta ni un vacío de conocimiento. ¿Qué falta para justificar científicamente el estudio?', ['Un problema de investigación delimitado y pertinente.','La certeza previa de que la hipótesis será confirmada.','La eliminación de toda referencia a conocimientos anteriores.','Un resultado elegido antes de diseñar el estudio.'])
    ]
    second=[
      (7,41,'Se seleccionan deliberadamente experiencias de éxito y fracaso muy inusuales para comprenderlas a fondo. ¿Qué selección se describe?', ['Muestreo de casos extremos.','Muestreo aleatorio simple por sorteo de toda la población.','Muestreo sistemático por intervalo fijo.','Censo de todos los habitantes.']),
      (7,41,'Los primeros informantes recomiendan a otros que cumplen los criterios del estudio. ¿Qué procedimiento se utiliza?', ['Muestreo por bola de nieve.','Muestreo aleatorio simple con probabilidades iguales conocidas.','Asignación aleatoria de un tratamiento.','Censo completo de la población.']),
      (7,43,f'Hay {n} personas en una lista y se desea una muestra sistemática de {sample}. ¿Cuál es el intervalo N/n?', [str(interval),str(interval+2),str(interval*2),str(n+sample)]),
      (7,43,'Se aplica muestreo sistemático a una lista. ¿Cómo debe elegirse el primer elemento para incorporar un arranque aleatorio?', ['Sorteando una posición entre 1 y el intervalo de selección.','Eligiendo siempre la posición 1 sin sorteo.','Escogiendo a la persona más cercana al investigador.','Preguntando solo a quienes se ofrecen voluntariamente.']),
      (7,44,'Se sortean participantes desde un marco completo, con la misma probabilidad conocida para cada unidad. ¿Qué muestreo se describe?', ['Aleatorio simple.','Por conveniencia.','De casos extremos.','Por bola de nieve.']),
      (7,44,'El intervalo de selección coincide con un patrón periódico de la lista. ¿Cuál es el riesgo?', ['Introducir sesgo al seleccionar repetidamente un mismo tipo de unidad.','Garantizar representatividad por el solo hecho de repetir el patrón.','Convertir automáticamente la selección en un censo.','Eliminar cualquier error de muestreo.']),
      (7,45,'Un estudio cualitativo busca experiencias pertinentes y profundidad de información. ¿Qué criterio orienta la selección?', ['La pertinencia de los participantes para comprender el fenómeno.','La popularidad del informe entre sus futuros lectores.','La obligación de usar siempre un sorteo probabilístico.','La elección exclusiva de personas con la misma opinión del investigador.']),
      (11,46,'Se estudia la accesibilidad a servicios considerando distancia, costo y disponibilidad. ¿Qué representan esos componentes?', ['Dimensiones de una variable compleja que requieren indicadores definidos.','Tres nombres equivalentes que no necesitan definición.','Tres resultados que deben ser idénticos en todos los participantes.','Categorías elegidas después para impedir cualquier medición.']),
      (7,47,'Se incluyen deliberadamente residentes rurales, urbanos y periurbanos para explorar diversidad de experiencias. ¿Qué selección se describe?', ['Muestreo de máxima variabilidad.','Muestreo que exige incluir un único perfil homogéneo.','Sorteo aleatorio simple por el solo hecho de incluir tres lugares.','Censo nacional por el solo hecho de incluir tres grupos.']),
      (7,49,'Un sector de la población queda sistemáticamente subrepresentado. ¿Qué problema aparece?', ['Sesgo de selección o de muestreo.','Ausencia garantizada de error.','Asignación aleatoria de tratamientos.','Conversión automática de la muestra en población.']),
      (11,50,'El estado civil se registra con códigos 1, 2 y 3. ¿Qué significado tienen esos números en una escala nominal?', ['Identifican categorías sin expresar orden ni magnitud.','Indican que la categoría 3 tiene el triple de estado civil que la 1.','Miden distancias físicas iguales entre estados civiles.','Convierten el estado civil en una variable continua.']),
      (10,91,'El grupo afectado identifica un problema, participa en los cambios y evalúa la mejora. ¿Qué diseño se aproxima a esa finalidad?', ['Investigación-acción.','Un diseño que excluye toda participación de los afectados.','Un inventario de materiales sin relación con el problema.','Un ensayo aleatorizado por el solo hecho de reunirse en grupo.']),
      (10,92,'Se busca comprender en profundidad el significado de una experiencia mediante entrevistas. ¿Qué enfoque resulta congruente?', ['Cualitativo.','Exclusivamente un recuento estadístico sin interpretar experiencias.','Un censo por el solo hecho de entrevistar.','Una prueba de laboratorio como única fuente admisible.']),
      (10,93,'¿Qué papel tiene el grupo afectado en la investigación-acción?', ['Participa activamente en comprender el problema y mejorar la acción.','Solo recibe decisiones externas y no puede discutirlas.','Debe quedar excluido de la identificación del problema.','Participa únicamente si desconoce el objetivo de cualquier cambio.']),
      (7,94,'¿Qué condición distingue al muestreo probabilístico?', ['Cada unidad tiene una probabilidad de selección conocida y mayor que cero.','Solo puede aplicarse si todas las personas son voluntarias.','Exige seleccionar exclusivamente a los casos más accesibles.','Prohíbe que puedan obtenerse muestras distintas de una población.']),
      (12,95,'Se seleccionan escuelas y luego se miden variables de cada estudiante. ¿Qué distinción corresponde?', ['La escuela puede ser unidad de muestreo y el estudiante unidad de análisis.','La unidad de análisis siempre debe ser idéntica a la unidad de muestreo.','El estudiante deja de ser observable porque se seleccionaron escuelas.','La unidad de muestreo es obligatoriamente el promedio de las notas.']),
      (12,97,'Una investigación evalúa características de centros educativos. ¿Cuál puede ser su unidad de estudio?', ['Cada centro educativo definido en la población.','Solo una persona, porque las instituciones nunca pueden ser unidades.','Únicamente el investigador que analiza las instituciones.','El número de páginas del informe en cualquier estudio.']),
      (10,98,'Se reconstruyen experiencias a través de historias de vida. ¿Qué diseño cualitativo se describe?', ['Narrativo.','Un ensayo clínico aleatorizado por definición.','Un estudio que prohíbe cualquier relato personal.','Un diseño limitado exclusivamente a contar equipos.']),
      (10,99,'¿Qué combinación de fuentes es congruente con un diseño narrativo?', ['Biografías, autobiografías, testimonios y entrevistas.','Únicamente una tabla de números sin relatos.','Solo el presupuesto y los recibos del proyecto.','Exclusivamente el nombre del software de análisis.']),
      (10,100,'Una narración se centra en una experiencia concreta y otra recorre una vida completa. ¿Qué alcance puede ser válido?', ['Ambos, según la pregunta y el diseño del estudio.','Solo la vida completa: un episodio nunca puede estudiarse.','Solo el episodio: una historia de vida nunca puede estudiarse.','Ninguno, porque el diseño narrativo excluye experiencias personales.'])
    ]
    source={q['numero_original']:q for q in read('api/_past_exams/2025-2026-'+('1' if scope=='first' else '2')+'.json')['questions']}
    rows=[]
    for i,(chapter,number,stem,options) in enumerate(first if scope=='first' else second):
        shift=(i+variant)%4;choices=options[-shift:]+options[:-shift] if shift else options;answer='ABCD'[shift];original=source[number]
        q={'id':f'vida-{scope}-expansion-{variant+1}-{i+1:02d}','pregunta':f'En {context}: {stem}','materia':'SALUD PUBLICA','tema':'Educación para la Vida · '+('Salud e introducción a investigación' if scope=='first' else 'Muestreo, variables y diseños cualitativos'),'coverage':{'subject':'SALUD PUBLICA','chapter':chapter,'curriculum':'past-exams-2025-2026'},'source_numero_original':number,'source_question_id':original['id'],'source_sha256':digest(original),'respuesta_correcta':answer,'respuestas_aceptadas':[answer],'fuente':f'Concepto evaluado en el {"primer" if scope=="first" else "segundo"} parcial 2025–2026 · pregunta {number}.','adaptation':'Situación de práctica nueva basada en el concepto del examen de referencia, con una única alternativa correcta.','comentario':f'Correcta {answer}: {options[0]}'}
        q.update({'opcion_'+key:value for key,value in zip('abcd',choices)});rows.append(q)
    return rows
