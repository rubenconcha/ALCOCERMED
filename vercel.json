{
  "functions": {
    "api/resumen.js": {
      "includeFiles": "api/_pdf/**"
    },
    "api/past-exam.js": {
      "includeFiles": "api/_past_exams/**"
    },
    "api/mindmap.js": {
      "includeFiles": "api/_mindmaps/**"
    },
    "api/atlas.js": {
      "includeFiles": "api/_atlas/**"
    },
    "api/simulation.js": {
      "includeFiles": "api/_simulations/**"
    },
    "api/flashcards.js": {
      "includeFiles": "api/_flashcards/**"
    },
    "api/topic-evaluation.js": {
      "includeFiles": "api/_evaluations/**"
    },
    "api/game-practice.js": {
      "includeFiles": "api/_game-practice/**"
    }
  },
  "headers": [
    {
      "source": "/resumenes/(.*).pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/juegos/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/campus",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/campus.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ingresar",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/registro",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/juegos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/jugar",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/:file.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/juegos/:file.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/descargas/tema-1-8d46c7b2/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/descargas/tema-1-8d46c7b2/Alcocermed_Tema_1_visual.pptx",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Alcocermed_Tema_1_visual.pptx\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/_game-practice/:path*",
      "destination": "/api/game-practice?id=invalid"
    },
    {
      "source": "/api/_flashcards/:path*",
      "destination": "/api/flashcards?invalid=1"
    },
    {
      "source": "/api/_evaluations/:path*",
      "destination": "/api/topic-evaluation?id=invalid"
    },
    {
      "source": "/api/_simulations/:path*",
      "destination": "/api/simulation?id=invalid"
    },
    {
      "source": "/assets/mindmaps/complete/morfo_18_sangre.png",
      "destination": "/api/mindmap?id=morfo_18_sangre&format=image"
    },
    {
      "source": "/assets/mindmaps/complete/morfo_16_organos_sentidos.png",
      "destination": "/api/mindmap?id=morfo_16_organos_sentidos&format=image"
    },
    {
      "source": "/mapas mentales/morfo_18_sangre.png",
      "destination": "/api/mindmap?id=morfo_18_sangre&format=image"
    },
    {
      "source": "/mapas mentales/morfo_16_organos_sentidos.png",
      "destination": "/api/mindmap?id=morfo_16_organos_sentidos&format=image"
    },
    {
      "source": "/musculos-interactivos",
      "destination": "/api/atlas"
    },
    {
      "source": "/atlas-anatomico",
      "destination": "/api/atlas"
    },
    {
      "source": "/api/_mindmaps/:path*",
      "destination": "/api/mindmap?id=invalid"
    },
    {
      "source": "/api/_past_exams/:path*",
      "destination": "/api/past-exam?id=invalid"
    },
    {
      "source": "/",
      "destination": "/ventas.html"
    },
    {
      "source": "/campus",
      "destination": "/campus.html"
    },
    {
      "source": "/ingresar",
      "destination": "/campus.html"
    },
    {
      "source": "/registro",
      "destination": "/registro.html"
    },
    {
      "source": "/planes",
      "destination": "/ventas.html"
    },
    {
      "source": "/propedeutico",
      "destination": "/ventas.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/juegos",
      "destination": "/juegos/index.html"
    },
    {
      "source": "/juegos/(.*)",
      "destination": "/juegos/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/musculos-interactivos.html",
      "destination": "/atlas-anatomico",
      "permanent": false
    },
    {
      "source": "/api/_atlas/:path*",
      "destination": "/campus?seccion=atlas",
      "permanent": false
    },
    {
      "source": "/juego",
      "destination": "/juegos/",
      "permanent": false
    },
    {
      "source": "/juego/",
      "destination": "/juegos/",
      "permanent": false
    }
  ]
}
