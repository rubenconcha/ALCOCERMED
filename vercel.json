{
  "rewrites": [
    {
      "source": "/propedeutico",
      "destination": "/ventas.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/juegos/(.*)",
      "destination": "/juegos/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
